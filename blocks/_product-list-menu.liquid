
{% assign block_settings = block.settings %}
{% assign menu = block_settings.menu %}

{% if menu != blank and menu.links.size > 0 %}
  {% liquid
    assign active_color = block_settings.active_color | default: '#e6007a'
    assign inactive_color = block_settings.inactive_color | default: '#8a8a8a'
  %}

  <nav
    class="product-list-category-menu"
    style="
      --pl-menu-active: {{ active_color }};
      --pl-menu-inactive: {{ inactive_color }};
      --pl-menu-gap: {{ block_settings.gap }}px;
    "
    aria-label="{{ menu.title | escape }}"
    {{ block.shopify_attributes }}
  >
    <ul class="product-list-category-menu__list list-unstyled">
      {% for link in menu.links %}
        <li class="product-list-category-menu__item">
          <a
            href="{{ link.url }}"
            class="product-list-category-menu__link{% if forloop.first %} product-list-category-menu__link--active{% endif %}"
            {% if forloop.first %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title | escape }}
          </a>
        </li>
      {% endfor %}
    </ul>
  </nav>
{% endif %}

{% stylesheet %}
  .product-list-category-menu {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    justify-content: center;
    max-width: 100%;
  }

  .product-list-category-menu__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: center;
    gap: var(--pl-menu-gap, 20px);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .product-list-category-menu__list::-webkit-scrollbar {
    display: none;
  }

  .product-list-category-menu__link {
    display: inline-block;
    color: var(--pl-menu-inactive, #8a8a8a);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.25rem;
    transition: color 0.2s ease;
  }

  .product-list-category-menu__link:hover {
    color: var(--pl-menu-active, #e6007a);
  }

  .product-list-category-menu__link--active,
  .product-list-category-menu__item:first-child .product-list-category-menu__link {
    color: var(--pl-menu-active, #e6007a);
  }

  .product-list-category-menu__item:not(:first-child) .product-list-category-menu__link {
    color: var(--pl-menu-inactive, #8a8a8a);
  }

  .product-list-category-menu__item:not(:first-child) .product-list-category-menu__link:hover {
    color: var(--pl-menu-active, #e6007a);
  }

  @media screen and (max-width: 749px) {
    .product-list-category-menu {
      order: 3;
      flex: 1 1 100%;
      justify-content: flex-start;
      margin-block-start: 0.25rem;
    }

    .product-list-category-menu__list {
      justify-content: flex-start;
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category menu",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Select a navigation menu (e.g. All, Body, Face, Eyes). Create one under Online Store → Navigation."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu"
    },
    {
      "type": "color",
      "id": "active_color",
      "label": "Active link color",
      "default": "#e6007a"
    },
    {
      "type": "color",
      "id": "inactive_color",
      "label": "Link color",
      "default": "#8a8a8a"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
