
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="
    {% render 'typography-style', preset: 'custom', settings: block_settings %}
    {% if block_settings.text_color != blank %}--color-utilities: {{ block_settings.text_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    {%- liquid
      assign copyright_shop_name = block_settings.shop_name_override | strip
      if copyright_shop_name == blank
        assign copyright_shop_name = shop.name
      endif
    -%}
    {%- if block_settings.copyright_format == 'full' -%}
      Copyright &copy; {{ 'now' | date: '%Y' }},
      {{ copyright_shop_name | link_to: routes.root_url }}.
      All rights reserved.
    {%- else -%}
      &copy; {{ 'now' | date: '%Y' }}
      {{ copyright_shop_name | link_to: routes.root_url -}}
    {%- endif -%}
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>
</div>

{% stylesheet %}
  .footer-utilities__group-copyright {
    color: var(--color-utilities, var(--color-foreground-muted));
    text-wrap: wrap;
    white-space: normal;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "select",
      "id": "copyright_format",
      "label": "Copyright format",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "full",
          "label": "Full sentence"
        }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "shop_name_override",
      "label": "Shop name override",
      "info": "Leave blank to use the store name. Example: Planet Beauty"
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
