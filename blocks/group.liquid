

{%- capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign group_extra_class = ''
  if block.settings.enable_stats_layout
    assign group_extra_class = 'group-block--stats'
    assign group_extra_class = group_extra_class | append: ' group-block--stats-desktop-' | append: block.settings.stats_desktop_columns
    assign group_extra_class = group_extra_class | append: ' group-block--stats-tablet-' | append: block.settings.stats_tablet_layout
    assign group_extra_class = group_extra_class | append: ' group-block--stats-mobile-' | append: block.settings.stats_mobile_layout
    if block.settings.show_top_divider
      assign group_extra_class = group_extra_class | append: ' group-block--stats-divider'
    endif
  endif
  if block.settings.mobile_columns == '2'
    assign group_extra_class = group_extra_class | append: ' group-block--mobile-cols-2'
  endif
%}

{% render 'group',
  children: children,
  settings: block.settings,
  shopify_attributes: block.shopify_attributes,
  background_color: block.settings.background_color,
  block_id: block.id,
  class: group_extra_class
%}

{% stylesheet %}
  .group-block--stats-divider {
    border-top: 1px solid #e5e5e5;
    padding-block-start: 20px;
  }

  .group-block--stats > .group-block-content {
    width: 100%;
    min-width: 0;
  }

  /* Don't let grid shrink crush 100K+ / labels onto two lines. */
  .group-block--stats > .group-block-content > * {
    min-width: min-content;
  }

  .group-block--stats .text-block,
  .group-block--stats .text-block > * {
    white-space: nowrap;
    text-wrap: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    max-inline-size: none;
  }

  .group-block--stats.group-block--stats-desktop-2 > .group-block-content {
    @media screen and (min-width: 991px) {
      display: grid;
      grid-template-columns: repeat(2, minmax(min-content, 1fr));
      gap: var(--gap);
    }
  }

  .group-block--stats.group-block--stats-desktop-3 > .group-block-content {
    @media screen and (min-width: 991px) {
      display: grid;
      grid-template-columns: repeat(3, minmax(min-content, 1fr));
      gap: var(--gap);
    }
  }

  .group-block--stats.group-block--stats-desktop-4 > .group-block-content {
    @media screen and (min-width: 991px) {
      display: grid;
      grid-template-columns: repeat(4, minmax(min-content, 1fr));
      gap: var(--gap);
    }
  }

  .group-block--stats.group-block--stats-tablet-columns_2 > .group-block-content {
    @media screen and (min-width: 750px) and (max-width: 990px) {
      display: grid;
      grid-template-columns: repeat(2, minmax(min-content, 1fr));
      gap: var(--gap);
      overflow-x: visible;
    }
  }

  .group-block--stats.group-block--stats-tablet-columns_3 > .group-block-content {
    @media screen and (min-width: 750px) and (max-width: 990px) {
      display: grid;
      grid-template-columns: repeat(3, minmax(min-content, 1fr));
      gap: var(--gap);
      overflow-x: visible;
    }
  }

  .group-block--stats.group-block--stats-tablet-scroll > .group-block-content {
    @media screen and (min-width: 750px) and (max-width: 990px) {
      display: flex;
      flex-flow: row nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: var(--gap);
    }
  }

  .group-block--stats.group-block--stats-tablet-scroll > .group-block-content::-webkit-scrollbar {
    display: none;
  }

  .group-block--stats.group-block--stats-tablet-scroll > .group-block-content > * {
    @media screen and (min-width: 750px) and (max-width: 990px) {
      flex: 0 0 40%;
      min-width: 160px;
    }
  }

  .group-block--stats.group-block--stats-mobile-stacked > .group-block-content {
    @media screen and (max-width: 749px) {
      display: flex;
      flex-flow: column nowrap;
      gap: var(--gap);
      overflow-x: visible;
    }
  }

  .group-block--stats.group-block--stats-mobile-columns_3 > .group-block-content {
    @media screen and (max-width: 749px) {
      display: grid;
      grid-template-columns: repeat(3, minmax(min-content, 1fr));
      gap: var(--gap);
      overflow-x: visible;
    }
  }

  .group-block--stats.group-block--stats-mobile-scroll > .group-block-content {
    @media screen and (max-width: 749px) {
      display: flex;
      flex-flow: row nowrap;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      gap: var(--gap);
    }
  }

  .group-block--stats.group-block--stats-mobile-scroll > .group-block-content::-webkit-scrollbar {
    display: none;
  }

  .group-block--stats.group-block--stats-mobile-scroll > .group-block-content > * {
    @media screen and (max-width: 749px) {
      flex: 0 0 70%;
      min-width: 140px;
    }
  }

  .group-block--mobile-cols-2 {
    @media screen and (max-width: 749px) {
      min-width: 0;
      max-width: 100%;
    }
  }

  .group-block--mobile-cols-2 > .group-block-content {
    @media screen and (max-width: 749px) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gap);
      align-items: stretch;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
  }

  .group-block--mobile-cols-2 > .group-block-content > * {
    @media screen and (max-width: 749px) {
      min-width: 0;
      max-width: 100%;
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.group",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "1",
      "info": "On mobile, keep a 2-column grid instead of stacking. Desktop layout is unchanged."
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ block.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ block.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ block.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "t:settings.custom_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.height == 'custom' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.background_media == 'none' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ block.settings.background_media == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.background_overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay_style",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ block.settings.toggle_overlay }}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to top",
      "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.block_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:settings.image",
      "visible_if": "{{ false }}"
    },
    {
      "type": "header",
      "content": "Stats layout"
    },
    {
      "type": "checkbox",
      "id": "enable_stats_layout",
      "label": "Enable stats layout",
      "info": "Responsive grid/scroll behavior for statistic columns.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show top divider",
      "info": "Renders a 1px #E5E5E5 border above the stats row.",
      "default": false,
      "visible_if": "{{ block.settings.enable_stats_layout }}"
    },
    {
      "type": "select",
      "id": "stats_desktop_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "3",
      "visible_if": "{{ block.settings.enable_stats_layout }}"
    },
    {
      "type": "select",
      "id": "stats_tablet_layout",
      "label": "Tablet layout",
      "options": [
        {
          "value": "columns_2",
          "label": "2 columns"
        },
        {
          "value": "columns_3",
          "label": "3 columns"
        },
        {
          "value": "scroll",
          "label": "Scroll"
        }
      ],
      "default": "columns_2",
      "visible_if": "{{ block.settings.enable_stats_layout }}"
    },
    {
      "type": "select",
      "id": "stats_mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "stacked",
          "label": "1 column stacked"
        },
        {
          "value": "columns_3",
          "label": "3 columns"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ],
      "default": "stacked",
      "visible_if": "{{ block.settings.enable_stats_layout }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.group",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
