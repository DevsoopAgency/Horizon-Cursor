{%- doc -%}
  Unique subtitle per collection card in a collection list.
  Uses card_index when passed from the parent list, otherwise matches
  closest.collection against section.settings.collection_list.

  @param {number} [card_index] - 1-based index of the card in the collection list
{%- enddoc -%}

{% liquid
  if card_index == blank or card_index == 0
    assign card_index = 0
    if closest.collection != blank and section.settings.collection_list != blank
      for listed_collection in section.settings.collection_list
        if listed_collection.id == closest.collection.id or listed_collection.handle == closest.collection.handle
          assign card_index = forloop.index
          break
        endif
      endfor
    endif
  endif

  assign subtitle = ''
  case card_index
    when 1
      assign subtitle = block.settings.subtitle_1
    when 2
      assign subtitle = block.settings.subtitle_2
    when 3
      assign subtitle = block.settings.subtitle_3
    when 4
      assign subtitle = block.settings.subtitle_4
    when 5
      assign subtitle = block.settings.subtitle_5
    when 6
      assign subtitle = block.settings.subtitle_6
    when 7
      assign subtitle = block.settings.subtitle_7
    when 8
      assign subtitle = block.settings.subtitle_8
  endcase

  if subtitle == blank
    assign subtitle = block.settings.default_subtitle
  endif

  assign subtitle_html = ''
  if subtitle != blank
    assign subtitle_safe = subtitle | escape
    assign subtitle_html = '<p>' | append: subtitle_safe | append: '</p>'
  elsif closest.collection.description != blank
    assign subtitle_html = closest.collection.description
  endif
%}

{% if subtitle_html != blank %}
  {% render 'text', fallback_text: subtitle_html, block: block %}
{% endif %}

