
{% render 'button', link: block.settings.link %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-unstyled",
          "label": "t:options.link"
        },
        {
          "value": "button-link-arrow",
          "label": "Text Link with Arrow"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "link_text_color",
      "label": "t:settings.link_text_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.style_class == 'button-unstyled' or block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "checkbox",
      "id": "link_underline",
      "label": "Show underline",
      "default": true,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "alignment_mobile",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "",
          "label": "Same as desktop"
        },
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Button Spacing",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "header",
      "content": "Desktop spacing",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_left",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_right",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "header",
      "content": "Tablet spacing",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_top_tablet",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom_tablet",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_left_tablet",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_right_tablet",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "header",
      "content": "Mobile spacing",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_top_mobile",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_bottom_mobile",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Mobile only. Overlay: lifts the button above the image. Stack: gap above the image.",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_left_mobile",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "range",
      "id": "spacing_right_mobile",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_typography",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_typography",
      "label": "t:settings.custom_mobile_typography",
      "default": false,
      "info": "t:info.custom_mobile_layout",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' }}"
    },
    {
      "type": "select",
      "id": "font_size_mobile",
      "label": "t:settings.mobile_size",
      "options": [
        {
          "value": "",
          "label": "t:options.default"
        },
        {
          "value": "10px",
          "label": "10px"
        },
        {
          "value": "11px",
          "label": "11px"
        },
        {
          "value": "12px",
          "label": "12px"
        },
        {
          "value": "13px",
          "label": "13px"
        },
        {
          "value": "14px",
          "label": "14px"
        },
        {
          "value": "15px",
          "label": "15px"
        },
        {
          "value": "16px",
          "label": "16px"
        },
        {
          "value": "18px",
          "label": "18px"
        }
      ],
      "default": "",
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' and block.settings.custom_mobile_typography }}"
    },
    {
      "type": "range",
      "id": "letter_spacing_mobile",
      "label": "t:settings.letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "default": 0.7,
      "visible_if": "{{ block.settings.style_class == 'button-link-arrow' and block.settings.custom_mobile_typography }}"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
