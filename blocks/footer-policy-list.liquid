
{% liquid
  assign use_custom_policies = block.settings.use_custom_links
  assign custom_policies_raw = block.settings.custom_links | strip
  assign has_custom_policies = false
  if use_custom_policies and custom_policies_raw != blank
    assign has_custom_policies = true
  endif
%}

{% if has_custom_policies or shop.policies.size > 0 %}
  {% if block.settings.layout == 'inline' %}
    <ul
      class="
        policy_list
        policy_list--inline
        list-unstyled
        custom-typography
        {% if block.settings.font_size != '' %}custom-font-size{% endif %}
      "
      style="
        {% render 'typography-style', preset: 'custom', settings: block.settings %}
        {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
      "
      {{ block.shopify_attributes }}
    >
      {%- if has_custom_policies -%}
        {%- assign custom_policies_normalized = custom_policies_raw | strip | newline_to_br | replace: '<br/>', '@@' | replace: '<br />', '@@' | replace: '<br>', '@@' -%}
        {%- assign custom_policy_lines = custom_policies_normalized | split: '@@' -%}
        {%- for line in custom_policy_lines -%}
          {%- assign policy_line = line | strip -%}
          {%- if policy_line != blank -%}
            {%- assign policy_parts = policy_line | split: '|' -%}
            {%- assign policy_label = policy_parts | first | strip -%}
            {%- if policy_parts.size > 1 -%}
              {%- assign policy_url = policy_parts[1] | strip -%}
            {%- else -%}
              {%- assign policy_url = '#' -%}
            {%- endif -%}
            {%- if policy_label != blank -%}
              <li>
                <a href="{{ policy_url }}" class="footer-utilities__text">
                  {{- policy_label | escape -}}
                </a>
              </li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li>
              <a href="{{ policy.url }}" class="footer-utilities__text">
                {{- policy.title | escape -}}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  {% else %}
    <anchored-popover-component
      data-hover-triggered="true"
    >
      <button
        class="policy-list-trigger button-unstyled"
        popovertarget="terms-policies-popover-{{ block.id }}"
        popovertargetaction="toggle"
        ref="trigger"
        style="
          {% render 'typography-style', preset: 'custom', settings: block.settings %}
          {% if block.settings.text_color != blank %}--color-utilities: {{ block.settings.text_color }};{% endif %}
        "
        {{ block.shopify_attributes }}
      >
        {{ 'content.terms_and_policies' | t }}
      </button>
      <div
        class="terms-policies-popover color-custom-popover"
        id="terms-policies-popover-{{ block.id }}"
        popover="auto"
        ref="popover"
      >
        <ul
          class="
            policy_list list-unstyled
            custom-typography
            {% if block.settings.font_size != '' %}custom-font-size{% endif %}
          "
        >
          {%- if has_custom_policies -%}
            {%- assign custom_policies_normalized = custom_policies_raw | strip | newline_to_br | replace: '<br/>', '@@' | replace: '<br />', '@@' | replace: '<br>', '@@' -%}
            {%- assign custom_policy_lines = custom_policies_normalized | split: '@@' -%}
            {%- for line in custom_policy_lines -%}
              {%- assign policy_line = line | strip -%}
              {%- if policy_line != blank -%}
                {%- assign policy_parts = policy_line | split: '|' -%}
                {%- assign policy_label = policy_parts | first | strip -%}
                {%- if policy_parts.size > 1 -%}
                  {%- assign policy_url = policy_parts[1] | strip -%}
                {%- else -%}
                  {%- assign policy_url = '#' -%}
                {%- endif -%}
                {%- if policy_label != blank -%}
                  <li>
                    <a href="{{ policy_url }}" class="footer-utilities__text">
                      {{- policy_label | escape -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a
                    href="{{ policy.url }}"
                    class="footer-utilities__text"
                  >
                    {{- policy.title | escape -}}
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </anchored-popover-component>
  {% endif %}
{% endif %}

{% stylesheet %}
  .policy-list-trigger {
    anchor-name: --terms-policies-trigger;
    cursor: pointer;
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
  }

  .policy_list--inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 8px 24px;
    margin: 0;
    color: var(--color-utilities, var(--color-foreground-muted));
    text-wrap: wrap;
    white-space: normal;
  }

  .policy_list--inline li {
    margin: 0;
  }

  .policy_list--inline a {
    color: inherit;
    display: inline;
    padding: 0;
    width: auto;
    font-size: var(--font-size, 0.75rem);
    line-height: 1.75;
    text-decoration: none;
    text-transform: var(--text-transform, none);
    white-space: normal;
  }

  .policy_list--inline a:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) {
    .utilities--blocks-2 .policy_list--inline,
    .utilities--layout-space-between .policy_list--inline {
      justify-content: flex-end;
    }
  }

  .policy_list:not(.policy_list--inline) li {
    border-radius: calc(var(--style-border-radius-popover) - 8px);
  }

  .policy_list:not(.policy_list--inline) li a {
    color: var(--color-foreground);
    display: inline-block;
    padding: 8px;
    text-align: start;
    width: 100%;
    outline-color: #0000;
    font-size: var(--font-size, 0.75rem);
    text-transform: var(--text-transform, none);
  }

  .policy_list:not(.policy_list--inline) li:is(:hover, :focus-within) {
    background: rgb(var(--color-foreground-rgb) / 0.15);
  }

  .terms-policies-popover {
    position-anchor: --terms-policies-trigger;
    inset: unset;
    bottom: calc(anchor(top) + 1rem);
    left: anchor(left);
    border-radius: var(--style-border-radius-popover);
    background: linear-gradient(var(--color-background) 0 100%),
      linear-gradient(rgb(var(--color-background-rgb) / 0.15) 0 100%);
    background-clip: padding-box, border-box;
    border: 1px solid #0000;
    box-shadow: var(--shadow-popover);
    padding: 8px;
    margin: 0;
    opacity: 0;
    scale: 0.94;
    translate: 0 6px;
    transform-origin: 3.9em 100%;
  }

  .terms-policies-popover.\:popover-open,
  .terms-policies-popover:popover-open {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }

  @media screen and (max-width: 749px) {
    .terms-policies-popover {
      left: anchor(center);
      transform: translate(-50%, 0);
      transform-origin: 0% 100%;
    }
  }

  @supports not (position-anchor: --account-button-trigger) {
    .terms-policies-popover {
      bottom: unset;
      top: calc(var(--anchor-top) * 1px);
      left: calc(var(--anchor-left) * 1px);
      transform: translate(0, calc(-100% - 1.25rem));
    }

    @media screen and (max-width: 749px) {
      .terms-policies-popover {
        left: calc((var(--anchor-left) + (var(--anchor-width) / 2)) * 1px);
        transform: translate(-50%, calc(-100% - 1.25rem));
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .terms-policies-popover {
      transition-property: display, overlay, opacity, scale, translate;
      transition-behavior: allow-discrete;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
    }

    @starting-style {
      .terms-policies-popover.\:popover-open,
      .terms-policies-popover:popover-open {
        opacity: 0.7;
        translate: 0 6px;
        scale: 0.94;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policy_list",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.manage_policies"
    },
    {
      "type": "checkbox",
      "id": "use_custom_links",
      "label": "Use custom links",
      "default": false,
      "info": "When enabled, Custom links replace shop policies."
    },
    {
      "type": "textarea",
      "id": "custom_links",
      "label": "Custom links",
      "info": "One per line: Label|/path-or-url",
      "visible_if": "{{ block.settings.use_custom_links == true }}"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "popover",
          "label": "Popover"
        },
        {
          "value": "inline",
          "label": "Inline links"
        }
      ],
      "default": "popover"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.75rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.policy_list",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
