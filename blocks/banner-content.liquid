{% liquid
  assign s = block.settings
  assign gap = s.gap | default: 20
  assign mobile_position = s.mobile_vertical_position | default: 'top'
  assign mobile_offset = s.mobile_offset_y | default: 0

  case mobile_position
    when 'top'
      assign y_mobile = 0
      assign justify_mobile = 'flex-start'
      assign use_custom_spacer = false
      assign anchor_mobile = 'top'
    when 'middle'
      assign y_mobile = 0
      assign justify_mobile = 'center'
      assign use_custom_spacer = false
      assign anchor_mobile = 'center'
    when 'bottom'
      assign y_mobile = 0
      assign justify_mobile = 'flex-end'
      assign use_custom_spacer = false
      assign anchor_mobile = 'bottom'
    else
      assign y_mobile = s.y_position_mobile | default: 12
      assign justify_mobile = 'flex-start'
      assign use_custom_spacer = true
      assign anchor_mobile = s.mobile_vertical_anchor | default: 'top'
      if s.mobile_vertical_anchor == 'center'
        assign justify_mobile = 'center'
        assign use_custom_spacer = false
      elsif s.mobile_vertical_anchor == 'bottom'
        assign justify_mobile = 'flex-end'
        assign use_custom_spacer = false
      endif
  endcase

  case s.text_alignment_mobile
    when 'flex-end'
      assign align_mobile = 'flex-end'
    when 'flex-start'
      assign align_mobile = 'flex-start'
    else
      assign align_mobile = 'center'
  endcase
%}

<div
  class="
    banner-content
    banner-content--{{ block.id }}
    banner-content--align-{{ s.text_alignment }}
    banner-content--align-mobile-{{ s.text_alignment_mobile }}
    banner-content--mobile-pos-{{ mobile_position }}
    {% if use_custom_spacer %}banner-content--mobile-spacer{% endif %}
  "
  data-mobile-anchor="{{ anchor_mobile | default: 'top' }}"
  style="
    --banner-content-x: {{ s.x_position }}%;
    --banner-content-y: {{ s.y_position }}%;
    --banner-content-width: {{ s.content_width }}px;
    --banner-content-x-mobile: {{ s.x_position_mobile }}%;
    --banner-content-y-mobile: {{ y_mobile }}%;
    --banner-content-justify-mobile: {{ justify_mobile }};
    --banner-content-align-mobile: {{ align_mobile }};
    --banner-content-offset-y-mobile: {{ mobile_offset }}px;
    --banner-content-width-mobile: {{ s.content_width_mobile }}px;
    --banner-content-gap: {{ gap }}px;
    --banner-content-gap-mobile: {{ s.gap_mobile | default: gap }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="banner-content__slot">
    <div class="banner-content__inner">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% style %}
  /* Block-scoped mobile pin — beats desktop center (top: 50% + translate -50%) */
  @media screen and (max-width: 749px) {
    .banner-content--{{ block.id }} {
      position: absolute !important;
      inset: 0 !important;
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      min-height: 100% !important;
      padding: 0 !important;
      pointer-events: none !important;
      box-sizing: border-box !important;
    }

    .banner-content--{{ block.id }} .banner-content__slot {
      position: absolute !important;
      left: 50% !important;
      right: auto !important;
      width: min(var(--banner-content-width-mobile), calc(100% - 2 * var(--hero-content-safe-inset, 1rem))) !important;
      max-width: 100% !important;
      margin: 0 !important;
      pointer-events: auto !important;
      box-sizing: border-box !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-top .banner-content__slot {
      top: var(--hero-content-safe-inset, 1rem) !important;
      bottom: auto !important;
      transform: translateX(-50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-middle .banner-content__slot {
      top: 50% !important;
      bottom: auto !important;
      transform: translate(-50%, -50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-bottom .banner-content__slot {
      top: auto !important;
      bottom: var(--hero-content-safe-inset, 1rem) !important;
      transform: translateX(-50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-custom .banner-content__slot {
      top: var(--banner-content-y-mobile, 12%) !important;
      bottom: auto !important;
      transform: translateX(-50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-custom[data-mobile-anchor='center'] .banner-content__slot {
      transform: translate(-50%, -50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }}.banner-content--mobile-pos-custom[data-mobile-anchor='bottom'] .banner-content__slot {
      top: auto !important;
      bottom: calc(100% - var(--banner-content-y-mobile, 12%)) !important;
      transform: translateX(-50%) translateY(var(--banner-content-offset-y-mobile, 0px)) !important;
    }

    .banner-content--{{ block.id }} .banner-content__inner {
      display: flex !important;
      flex-direction: column !important;
      gap: var(--banner-content-gap-mobile, 16px) !important;
      width: 100% !important;
      align-items: var(--banner-content-align-mobile, center) !important;
    }

    .banner-content--{{ block.id }} .banner-content__inner > *,
    .banner-content--{{ block.id }} .banner-content__inner .text-block,
    .banner-content--{{ block.id }} .banner-content__inner .text-block > *,
    .banner-content--{{ block.id }} .banner-content__inner :is(.button, .button-link-arrow, .button-unstyled) {
      margin-block: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
  }
{% endstyle %}

{% stylesheet %}
  /*
    Desktop: absolute pin at x/y (center-anchored).
    Mobile: block-scoped {% style %} above overrides — Top/Middle/Bottom.
  */
  .banner-content {
    position: absolute;
    inset: 0;
    z-index: var(--layer-flat);
    pointer-events: none;
  }

  .banner-content__slot {
    position: absolute;
    left: clamp(
      calc(var(--hero-content-safe-inset, var(--page-margin, 1rem)) + (var(--banner-content-width) / 2)),
      var(--banner-content-x),
      calc(100% - var(--hero-content-safe-inset, var(--page-margin, 1rem)) - (var(--banner-content-width) / 2))
    );
    top: var(--banner-content-y);
    width: min(
      var(--banner-content-width),
      calc(100% - (2 * var(--hero-content-safe-inset, var(--page-margin, 1rem))))
    );
    transform: translate(-50%, -50%);
    pointer-events: auto;
    box-sizing: border-box;
  }

  .banner-content__inner {
    display: flex;
    flex-direction: column;
    gap: var(--banner-content-gap, 20px);
    width: 100%;
    max-width: 100%;
  }

  .banner-content--align-flex-start .banner-content__inner {
    align-items: flex-start;
    text-align: left;
  }

  .banner-content--align-center .banner-content__inner {
    align-items: center;
    text-align: center;
  }

  .banner-content--align-flex-end .banner-content__inner {
    align-items: flex-end;
    text-align: right;
  }

  .banner-content__inner > * {
    max-width: 100%;
  }

  /* Adaptive height: stay in-flow so content defines section min-height */
  .hero--height-adaptive .banner-content {
    position: relative;
    inset: auto;
    width: 100%;
    pointer-events: auto;
  }

  .hero--height-adaptive .banner-content__slot {
    position: relative;
    left: auto;
    top: auto;
    transform: none;
    width: min(
      var(--banner-content-width),
      calc(100% - (2 * var(--hero-content-safe-inset, var(--page-margin, 1rem))))
    );
    margin-inline-start: clamp(
      var(--hero-content-safe-inset, var(--page-margin, 1rem)),
      calc(var(--banner-content-x) - (var(--banner-content-width) / 2)),
      max(
        var(--hero-content-safe-inset, var(--page-margin, 1rem)),
        calc(100% - var(--banner-content-width) - var(--hero-content-safe-inset, var(--page-margin, 1rem)))
      )
    );
  }

  .hero--height-adaptive .hero__content-wrapper:has(.banner-content) {
    width: 100%;
    align-self: stretch;
  }

  @media screen and (max-width: 749px) {
    .banner-content--align-mobile-center .banner-content__inner {
      align-items: center;
      text-align: center;
    }

    .banner-content--align-mobile-center .banner-content__inner :is(.button, .button-link-arrow, .button-unstyled) {
      margin-inline: auto !important;
    }

    .banner-content--align-mobile-flex-start .banner-content__inner {
      align-items: flex-start;
      text-align: left;
    }

    .banner-content--align-mobile-flex-end .banner-content__inner {
      align-items: flex-end;
      text-align: right;
    }

    .hero--height-adaptive .banner-content {
      position: relative !important;
      inset: auto !important;
      min-height: 12rem;
      height: auto !important;
    }

    .hero--height-adaptive .banner-content__slot {
      position: relative !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      width: min(var(--banner-content-width-mobile), 100%) !important;
      margin-inline: auto !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
