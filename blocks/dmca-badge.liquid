
{% assign block_settings = block.settings %}
{% assign badge_width = block_settings.width | default: 72 %}

{% if block_settings.image != blank %}
  {% assign badge_src = block_settings.image | image_url: width: 400 %}
  {% assign badge_alt = block_settings.image.alt | default: 'DMCA Protected' %}
{% else %}
  {% assign badge_src = 'dmca-protected.svg' | asset_url %}
  {% assign badge_alt = 'DMCA Protected' %}
{% endif %}

<a
  class="dmca-badge spacing-style"
  href="{{ block_settings.link | default: 'https://www.dmca.com/' }}"
  {% if block_settings.open_in_new_tab %}
    target="_blank"
    rel="noopener noreferrer"
  {% endif %}
  style="
    --dmca-badge-width: {{ badge_width }}px;
    {% render 'spacing-style', settings: block_settings %}
  "
  aria-label="{{ badge_alt | escape }}"
  {{ block.shopify_attributes }}
>
  <img
    class="dmca-badge__image"
    src="{{ badge_src }}"
    alt="{{ badge_alt | escape }}"
    width="{{ badge_width }}"
    height="{{ badge_width | times: 0.4 | round }}"
    loading="lazy"
  >
</a>

{% stylesheet %}
  .dmca-badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: var(--dmca-badge-width, 72px);
    text-decoration: none;
  }

  .dmca-badge__image {
    width: var(--dmca-badge-width, 72px);
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DMCA badge",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "Optional. Uses the theme DMCA badge if empty."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": true
    },
    {
      "type": "range",
      "id": "width",
      "label": "t:settings.width",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
