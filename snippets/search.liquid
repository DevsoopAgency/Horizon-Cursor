{%- doc -%}
  Renders the search action button or inline search field.

  @param {string} [style] - The style of the search action ('none', 'modal', 'field').
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
  @param {string} [placeholder] - Placeholder text for the field style.

  @example
  {% render 'search', style: 'field', class: 'custom-class', display_style: 'icon' %}
{%- enddoc -%}

{% liquid
  if placeholder != blank
    assign search_placeholder = placeholder
  else
    assign search_placeholder = 'content.search_input_placeholder' | t
  endif
%}

{% unless style == 'none' %}
  {% if style == 'field' %}
    <search-button
      class="search-action search-action--field{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
    >
      <button
        type="button"
        on:click="#search-modal/showDialog"
        class="button-unstyled header-actions__action search-action__icon-trigger{% if display_style == 'text' %} header-actions__text-style{% endif %}"
        aria-label="{{ 'content.search_input_label' | t }}"
        aria-haspopup="dialog"
      >
        <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
          {{ 'content.search' | t }}
        </span>

        <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
          {{ 'icon-search.svg' | inline_asset_content }}
        </span>
      </button>

      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="search-action__field"
      >
        <label
          class="visually-hidden"
          for="HeaderSearchInput-{{ section.id | default: 'header' }}"
        >
          {{ 'content.search_input_label' | t }}
        </label>
        <input
          id="HeaderSearchInput-{{ section.id | default: 'header' }}"
          class="search-action__input"
          type="search"
          name="q"
          placeholder="{{ search_placeholder | escape }}"
          autocomplete="off"
          aria-haspopup="dialog"
          on:click="#search-modal/showDialog"
        >
      </form>
    </search-button>
  {% else %}
    <search-button
      class="search-action{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
    >
      <button
        on:click="#search-modal/showDialog"
        class="button-unstyled header-actions__action{% if display_style == 'text' %} header-actions__text-style{% endif %}"
        aria-label="{{ 'content.search_input_label' | t }}"
        aria-haspopup="dialog"
      >
        <span class="{% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
          {{ 'content.search' | t }}
        </span>

        <span class="svg-wrapper {% if display_style != 'icon' %}desktop:hidden{% endif %}">
          {{ 'icon-search.svg' | inline_asset_content }}
        </span>
      </button>
    </search-button>
  {% endif %}
{% endunless %}

{% stylesheet %}
  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
    align-items: center;
  }

  @media screen and (max-width: 749px) {
    .search-action--hidden-on-drawer {
      display: none;
    }

    .search-action--field .search-action__field {
      display: none;
    }
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }

    .search-action--field .search-action__icon-trigger {
      display: none;
    }
  }

  [data-menu-style='menu'] .header__column--left .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }

  @media screen and (min-width: 750px) {
    .header__column--right .search-action--text,
    .header__column--right .search-action--field {
      margin-inline: 0;
    }

    [data-menu-style='menu'] .header__column--left .search-action--text,
    [data-menu-style='menu'] .header__column--left .search-action--field {
      margin-inline: 0;
    }
  }

  .search-action__field {
    display: flex;
    align-items: center;
    min-width: 12rem;
    max-width: 16rem;
    width: clamp(12rem, 18vw, 16rem);
  }

  .search-action__input {
    width: 100%;
    margin: 0;
    padding: 0.35rem 0;
    border: 0;
    border-radius: 0;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.25);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: var(--font-body--weight);
    line-height: 1.3;
    outline: none;
    box-shadow: none;
    appearance: none;
  }

  .search-action__input::placeholder {
    color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.45);
    opacity: 1;
  }

  .search-action__input:focus,
  .search-action__input:focus-visible {
    border-bottom-color: rgb(var(--color-foreground-rgb, 0 0 0) / 0.55);
    outline: none;
    box-shadow: none;
  }
{% endstylesheet %}
