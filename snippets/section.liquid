{%- doc -%}
  Renders a wrapper section

  @param {section} section - The section object
  @param {string} children - The children of the section
  @param {string} section_id - The ID of the section
  @param {string} background_color - The background color of the section
{%- enddoc -%}

{% liquid
  assign skip_contrast = false
  if section.settings.background_media != blank and section.settings.background_media != 'none'
    assign skip_contrast = true
  endif
%}
{% render 'contrast-override',
  background_color: background_color,
  section_id: section_id,
  skip_contrast: skip_contrast
%}

<div
  class="section-background color-custom-{{ section_id }}"
  {% if section.settings.background_gradient_start != blank and section.settings.background_gradient_end != blank %}
    style="background: linear-gradient(180deg, {{ section.settings.background_gradient_start }}, {{ section.settings.background_gradient_end }});"
  {% endif %}
></div>
<div
  class="section section--{{ section.settings.section_width }} color-custom-{{ section_id }}{% if section.settings.section_height == 'fixed' %} section--fixed-height{% endif %}"
  data-testid="ui-test-section"

  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}

  style="
    {% if section.settings.section_height == 'fixed' %}
      --section-min-height: {{ section.settings.section_height_px }}px;
    {% elsif section.settings.section_height == 'custom' %}
      --section-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif section.settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}

    {% if section.settings.section_height != blank and section.settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}

    {% liquid
      assign split_media_max = section.settings.split_media_max_width | default: 0 | plus: 0
      assign split_content_max = section.settings.split_content_max_width | default: 0 | plus: 0
      assign use_split_caps = false
      if split_media_max > 0
        assign use_split_caps = true
      endif
    %}

    {% if use_split_caps %}
      --split-media-max-width: {{ split_media_max }}px;
      --split-content-max-width: {{ split_content_max }}px;
    {% endif %}
  "
>
  <div class="custom-section-background">
    {% render 'background-media',
      background_media: section.settings.background_media,
      background_video: section.settings.video,
      background_video_position: section.settings.video_position,
      background_image: section.settings.background_image,
      background_image_position: section.settings.background_image_position
    %}
  </div>

  <div
    class="border-style custom-section-content{% if use_split_caps %} custom-section-content--split-caps{% endif %}"
    style="{% render 'border-override', settings: section.settings %}"
  >
    {% if section.settings.toggle_overlay %}
      {% render 'overlay', settings: section.settings, layer: '0' %}
    {% endif %}

    <div
      class="
        spacing-style
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        section-content-wrapper
        {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
      "
      style="
        {% render 'layout-panel-style', settings: section.settings %}
        {% render 'spacing-style', settings: section.settings %}
      "
      data-testid="section-content"
    >
      {{ children }}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(#header-group > .header-section > #header-component[transparent]):not(
      :has(#header-group > .header-section + .shopify-section)
    )
    #MainContent
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }

  .section.section--fixed-height {
    min-height: var(--section-min-height);
  }

  .section.section--fixed-height .section-content-wrapper {
    min-height: inherit;
    justify-content: center;
  }

  /* Beauty routine: full-bleed dark band, inset media + copy like Figma */
  .custom-section-content--split-caps {
    width: 100%;
  }

  .custom-section-content--split-caps .section-content-wrapper {
    width: 100%;
    max-width: none;
    margin-inline: auto;
    /* Figma ~99px side inset from dark band edge → image sits inside the black */
    padding-inline: clamp(48px, 6.875vw, 99px);
    padding-block: clamp(64px, 7vw, 131px);
    box-sizing: border-box;
  }

  .custom-section-content--split-caps .group-block-content.layout-panel-flex--row {
    align-items: center;
    justify-content: flex-start;
    gap: 75px !important;
    width: 100%;
  }

  .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .image-block {
    flex: 0 0 auto;
    width: min(100%, var(--split-media-max-width)) !important;
    max-width: var(--split-media-max-width);
    min-width: 0;
    aspect-ratio: 565 / 438;
  }

  .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .image-block .image-block__image,
  .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .image-block .placeholder-image {
    width: 100%;
    height: 100%;
    aspect-ratio: 565 / 438;
    object-fit: cover;
    border-radius: 20px;
  }

  .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .group-block {
    flex: 1 1 auto;
    width: min(100%, var(--split-content-max-width)) !important;
    max-width: var(--split-content-max-width);
    min-width: 0;
  }

  @media screen and (max-width: 1200px) {
    .custom-section-content--split-caps .section-content-wrapper {
      padding-inline: 48px;
      padding-block: 64px;
    }

    .custom-section-content--split-caps .group-block-content.layout-panel-flex--row {
      gap: 40px !important;
    }
  }

  @media screen and (max-width: 749px) {
    .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .image-block,
    .custom-section-content--split-caps .group-block-content.layout-panel-flex--row > .group-block {
      flex-basis: 100%;
      width: 100% !important;
      max-width: 100%;
    }

    .section.section--fixed-height {
      min-height: 0;
    }

    .custom-section-content--split-caps .section-content-wrapper {
      padding-inline: 20px;
      padding-block: 40px;
    }
  }
{% endstylesheet %}
