{%- doc -%}
  @param [limit] - {number} The maximum number of items to display. Anything above shows as "99+".
  @param [badge_visibility] - {string} 'when_has_items' (default) or 'always'

  Colors: reads --cart-bubble-background / --cart-bubble-text from an ancestor. Falls back to a contrasting pair
  computed from the palette foreground when unset.
{%- enddoc -%}

{% liquid
  assign bubble_bg_fallback = settings.page_text_color
  assign bubble_text_fallback = settings.page_background_color
  assign badge_visibility = badge_visibility | default: 'when_has_items'
  assign hide_when_empty = true
  if badge_visibility == 'always'
    assign hide_when_empty = false
  endif
%}

<span
  ref="cartBubble"
  class="cart-bubble cart-count-badge{% if cart == empty and hide_when_empty %} visually-hidden{% endif %}"
  style="--cart-bubble-background-fallback: {{ bubble_bg_fallback }}; --cart-bubble-text-fallback: {{ bubble_text_fallback }};"
  {% assign item_count = cart.item_count %}
  {% if item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
  >
    <span
      class="cart-bubble__text-count{% if cart == empty and hide_when_empty %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or cart.item_count < limit %}
        {{- cart.item_count -}}
      {%- endif -%}
    </span>
  </span>
</span>

{% stylesheet %}
  .cart-bubble {
    --cart-padding: 2px;

    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: normal;
    align-items: center;
    justify-content: center;
    color: var(--cart-bubble-text, var(--cart-bubble-text-fallback));
    padding-inline: var(--cart-padding);
  }

  /* Figma count badge: self-contained circle, no legacy padding/bg layer */
  .cart-bubble.cart-count-badge {
    --cart-padding: 0;

    padding: 0;
    overflow: visible;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble[data-maintain-ratio] .cart-bubble__background {
    border-radius: 50%;
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;
    background-color: var(--cart-bubble-background, var(--cart-bubble-background-fallback));
    border-radius: 50%;
  }

  .cart-bubble__text {
    font-size: var(--font-size--3xs);
    z-index: var(--layer-flat);
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}
