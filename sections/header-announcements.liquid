
{% liquid
  assign layout_style = section.settings.layout_style | default: 'slideshow'
  assign is_marquee = false
  assign slideshow_on_mobile = false
  if layout_style == 'marquee'
    assign is_marquee = true
    if section.settings.slideshow_on_mobile
      assign slideshow_on_mobile = true
    endif
  endif
%}

{% if is_marquee %}
  <script
    src="{{ 'marquee.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% elsif section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{% capture announcement_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="
    announcement-bar
    spacing-style
    section
    section--{{ section.settings.section_width }}
    color-custom-{{ section.id }}
    {% if is_marquee %}announcement-bar--marquee{% endif %}
    {% if slideshow_on_mobile %}announcement-bar--mobile-slideshow{% endif %}
  "
  style="
    {% render 'spacing-padding', settings: section.settings %};
    --border-bottom-width: {{ section.settings.divider_width }}px;
    {% if section.settings.divider_color != blank %}--color-border: {{ section.settings.divider_color }};{% endif %}
    {% if is_marquee %}
      {% render 'gap-style', value: section.settings.gap_between_elements, name: 'marquee-gap' %}
      --marquee-direction: {{ section.settings.movement_direction }};
    {% endif %}
  "
>
  {% if is_marquee %}
    <marquee-component
      class="announcement-bar__marquee"
      data-speed-factor="25"
      data-movement-direction="{{ section.settings.movement_direction }}"
    >
      <div
        class="marquee__wrapper"
        ref="wrapper"
      >
        <div
          class="marquee__content"
          ref="content"
        >
          <div
            class="marquee__repeated-items"
            ref="marqueeItems[]"
          >
            {{ announcement_blocks }}
          </div>
        </div>
      </div>
    </marquee-component>
  {% else %}
    {% liquid
      assign autoplay = false
      assign show_arrows = false
      if section.blocks.size > 1
        assign autoplay = true
        assign show_arrows = true
      endif
    %}

    <announcement-bar-component
      class="announcement-bar__slider"
      {% if autoplay == true %}
        autoplay="{{ section.settings.speed }}" aria-live="polite"
      {% endif %}
    >
      {% if show_arrows %}
        {% render 'slideshow-arrows', icon_style: 'chevron' %}
      {% endif %}

      <div class="announcement-bar__slides">
        {{ announcement_blocks }}
      </div>
    </announcement-bar-component>
  {% endif %}
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar--marquee {
    overflow: hidden;
  }

  .announcement-bar__marquee {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .announcement-bar--marquee .marquee__wrapper {
    display: flex;
    gap: 0;
    width: fit-content;
    white-space: nowrap;
  }

  .announcement-bar--marquee .marquee__content {
    min-width: max-content;
    display: flex;
    gap: 0;
  }

  .announcement-bar--marquee .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: 0;
    align-items: center;
    justify-content: center;
  }

  .announcement-bar--marquee .marquee__repeated-items > * {
    align-content: center;
  }

  .announcement-bar--marquee .announcement-bar__marquee-item {
    display: block;
    flex-shrink: 0;
    width: max-content;
    max-width: none;
    position: relative;
    white-space: nowrap;
  }

  .announcement-bar--marquee .announcement-bar__marquee-item .announcement-bar__text {
    display: inline;
    white-space: nowrap;
    margin: 0;
    text-wrap: nowrap;
  }

  .announcement-bar--marquee .announcement-bar__marquee-item .announcement-bar__text::after {
    content: '·';
    margin-inline: var(--marquee-gap);
    color: inherit;
    font-weight: inherit;
  }

  @media (prefers-reduced-motion: no-preference) {
    .announcement-bar--marquee marquee-component:not([data-disabled]) .marquee__wrapper {
      animation: announcement-marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes announcement-marquee-motion {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar--mobile-slideshow.announcement-bar--marquee marquee-component:not([data-disabled]) .marquee__wrapper,
    .announcement-bar--mobile-slideshow .marquee__wrapper {
      animation: none;
      transform: none;
      width: 100%;
      justify-content: center;
    }

    .announcement-bar--mobile-slideshow .marquee__content,
    .announcement-bar--mobile-slideshow .marquee__repeated-items {
      min-width: 0;
      width: 100%;
      justify-content: center;
    }

    .announcement-bar--mobile-slideshow .marquee__content[aria-hidden='true'],
    .announcement-bar--mobile-slideshow .marquee__wrapper > .marquee__content:not(:first-child),
    .announcement-bar--mobile-slideshow .marquee__repeated-items:not(:first-child),
    .announcement-bar--mobile-slideshow .marquee__repeated-items > *:not(:first-child) {
      display: none;
    }

    .announcement-bar--mobile-slideshow .announcement-bar__marquee-item {
      width: 100%;
      max-width: 100%;
      padding-inline: 1rem;
    }

    .announcement-bar--mobile-slideshow .announcement-bar__marquee-item .announcement-bar__text {
      display: block;
      width: 100%;
      text-align: center;
      white-space: nowrap;
    }

    .announcement-bar--mobile-slideshow .announcement-bar__marquee-item .announcement-bar__text::after {
      content: none;
      margin: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:settings.layout_style",
      "options": [
        {
          "value": "slideshow",
          "label": "t:names.slideshow"
        },
        {
          "value": "marquee",
          "label": "t:names.marquee"
        }
      ],
      "default": "slideshow"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.layout_style == 'slideshow' }}"
    },
    {
      "type": "select",
      "id": "movement_direction",
      "label": "t:settings.motion_direction",
      "options": [
        {
          "value": "reverse",
          "label": "t:options.forward"
        },
        {
          "value": "normal",
          "label": "t:options.reverse"
        }
      ],
      "default": "reverse",
      "visible_if": "{{ section.settings.layout_style == 'marquee' }}"
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.layout_style == 'marquee' }}"
    },
    {
      "type": "checkbox",
      "id": "slideshow_on_mobile",
      "label": "t:settings.slideshow_on_mobile",
      "default": false,
      "visible_if": "{{ section.settings.layout_style == 'marquee' }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
