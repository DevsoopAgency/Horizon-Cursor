

{% liquid
  assign media_class_modifier = 'media-with-content--' | append: section.settings.media_width

  if section.settings.extend_media and section.settings.section_width == 'page-width'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-extend'
  endif

  if section.settings.media_position == 'right'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-right'
  endif

  if section.settings.media_inset > 0 or section.settings.media_inset_mobile > 0 or section.settings.media_border_radius > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--media-framed'
  endif

  if section.settings.content_button_border_radius > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--custom-button-radius'
  endif

  if section.settings.media_vertical_alignment == 'center'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--align-center'
  endif

  if section.settings.media_height == 'adaptive'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--height-adaptive'
  elsif section.settings.media_height == 'custom'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--height-fixed media-with-content--height-custom'
  elsif section.settings.media_height != 'auto'
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--height-fixed'
  endif

  if section.settings.media_width_custom > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--width-custom-desktop'
  endif

  if section.settings.media_width_custom_mobile > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--width-custom-mobile'
  endif

  if section.settings.custom_content_padding
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--custom-content-padding'
  endif

  if section.settings.color_background != blank
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--content-panel-bg'
  endif

  if section.settings.scale_content_typography
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--scale-typography'
  endif

  if section.settings.content_max_width > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--content-max-width'
  endif

  if section.settings.text_alignment_desktop != blank
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--align-desktop-' | append: section.settings.text_alignment_desktop
  endif

  if section.settings.text_alignment_mobile != blank
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--align-mobile-' | append: section.settings.text_alignment_mobile
  endif

  assign mobile_heading_size = section.settings.content_heading_size_mobile | times: 1
  if mobile_heading_size == 0 and section.settings.media_height == 'custom' and section.settings.media_vertical_alignment == 'center' and section.settings.content_button_border_radius == 100
    assign mobile_heading_size = 32
  endif

  if mobile_heading_size > 0
    assign media_class_modifier = media_class_modifier | append: ' media-with-content--heading-mobile'
  endif

  assign has_custom_background = false
  assign background_for_contrast = section.settings.background_color

  if section.settings.background_style == 'gradient'
    assign has_custom_background = true
    assign background_for_contrast = section.settings.background_gradient_end | default: '#000000'
  elsif section.settings.background_color != blank
    assign has_custom_background = true
  endif
%}

{% liquid
  if has_custom_background and background_for_contrast != blank
    render 'contrast-override', background_color: background_for_contrast, section_id: section.id
  endif
%}

<div
  class="section-background{% if has_custom_background %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- if section.settings.background_style == 'gradient' -%}
      background: linear-gradient(
        {{ section.settings.background_gradient_direction | default: 'to bottom' }},
        {{ section.settings.background_gradient_start | default: '#404040' }},
        {{ section.settings.background_gradient_end | default: '#000000' }}
      );
    {%- endif -%}
  "
></div>
<div
  class="section section--{{ section.settings.section_width }} disable-section-top-offset media-with-content{% if has_custom_background %} color-custom-{{ section.id }}{% endif %} spacing-style {{ media_class_modifier }}"
  data-testid="media-with-content"
  style="
    {%- render 'spacing-style', settings: section.settings %}
    {% render 'border-override', settings: section.settings %}
    --media-with-content-media-inset: {{ section.settings.media_inset | default: 0 }}px;
    --media-with-content-media-inset-mobile: {{ section.settings.media_inset_mobile | default: section.settings.media_inset | default: 0 }}px;
    --media-with-content-media-radius: {{ section.settings.media_border_radius | default: 0 }}px;
    --media-with-content-media-width: {{ section.settings.media_width_custom | default: 0 }}px;
    --media-with-content-media-width-mobile: {{ section.settings.media_width_custom_mobile | default: 0 }}px;
    --media-with-content-button-radius: {{ section.settings.content_button_border_radius | default: 0 }}px;
    {%- case section.settings.media_height %}
      {% when '50svh' %}
        --media-height: 50svh;
        --media-height-mobile: 30svh;
      {% when '60svh' %}
        --media-height: 60svh;
        --media-height-mobile: 50svh;
      {% when '80svh' %}
        --media-height: 80svh;
        --media-height-mobile: 70svh;
      {% when '100svh' %}
        --media-height: 100svh;
        --media-height-mobile: 100svh;
      {% when 'custom' %}
        --media-height: {{ section.settings.media_height_custom | default: 500 }}px;
        --media-height-mobile: {{ section.settings.media_height_custom_mobile | default: 320 }}px;
      {% when 'adaptive' %}
        --media-height: auto;
        --media-height-mobile: auto;
      {% else %}
        --media-height: auto;
        --media-height-mobile: auto;
    {% endcase -%}

    {% if section.settings.media_height != 'auto' and section.settings.media_height != 'adaptive' %}
     --section-preview-height: 600px;
     {% endif %}

    {%- if section.settings.media_height != 'auto' and section.settings.media_height != 'adaptive' and section.settings.media_height != 'custom' -%}
      --media-with-content-section-min-height: var(--media-height);
    {%- endif -%}
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
>
  {% content_for 'block', type: '_media-without-appearance', id: 'media' %}

  {% content_for 'block', type: '_content-without-appearance', id: 'content' %}
</div>

{% style %}
  #shopify-section-{{ section.id }} {
    --padding-top: {{ section.settings.content_padding_top | default: 0 }}px;
    --padding-bottom: {{ section.settings.content_padding_bottom | default: 0 }}px;
    --padding-left: {{ section.settings.content_padding_left | default: 0 }}px;
    --padding-right: {{ section.settings.content_padding_right | default: 0 }}px;
    --padding-top-tablet: {{ section.settings.content_padding_top_tablet | default: 0 }}px;
    --padding-bottom-tablet: {{ section.settings.content_padding_bottom_tablet | default: 0 }}px;
    --padding-left-tablet: {{ section.settings.content_padding_left_tablet | default: 0 }}px;
    --padding-right-tablet: {{ section.settings.content_padding_right_tablet | default: 0 }}px;
    --padding-top-mobile: {{ section.settings.content_padding_top_mobile | default: 0 }}px;
    --padding-bottom-mobile: {{ section.settings.content_padding_bottom_mobile | default: 0 }}px;
    --padding-left-mobile: {{ section.settings.content_padding_left_mobile | default: 0 }}px;
    --padding-right-mobile: {{ section.settings.content_padding_right_mobile | default: 0 }}px;
    --content-panel-bg: {{ section.settings.color_background | default: 'transparent' }};
    --content-max-width: {{ section.settings.content_max_width | default: 504 }}px;
    --media-with-content-heading-mobile: {{ mobile_heading_size | default: 0 }}px;
    --spotlight-heading-size: {{ section.settings.heading_size_desktop | default: 48 }}px;
    --spotlight-heading-size-tablet: {{ section.settings.heading_size_tablet | default: 36 }}px;
    --spotlight-heading-size-mobile: {{ section.settings.heading_size_mobile | default: 28 }}px;
    --spotlight-heading-line-height: {{ section.settings.heading_line_height | default: 55 }}px;
    --spotlight-heading-color: {{ section.settings.heading_color | default: '#0A0A0A' }};
    --spotlight-eyebrow-letter-spacing: {{ section.settings.eyebrow_letter_spacing | default: 1 }}px;
    --spotlight-stat-size: 40px;
    --spotlight-stat-size-tablet: 32px;
    --spotlight-stat-size-mobile: 28px;
  }
{% endstyle %}

{% stylesheet %}
  .section--page-width {
    &.media-with-content {
      grid-template-areas: 'margin-left media margin-right' 'margin-left content margin-right';

      @media screen and (min-width: 750px) {
        /* Wide proportion is media 3.5 parts, content 2.5 parts. Which equals 7|5. So divide the central column by 7+5 and multiply accordingly */
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 12) * 7)
          calc((var(--full-page-grid-central-column-width) / 12) * 5) var(--full-page-grid-margin);

        grid-template-areas: 'margin-left media content margin-right';
      }
    }

    &.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 12) * 5)
          calc((var(--full-page-grid-central-column-width) / 12) * 7) var(--full-page-grid-margin);

        grid-template-areas: 'margin-left content media margin-right';
      }
    }

    &.media-with-content--medium {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          repeat(2, calc(var(--full-page-grid-central-column-width) / 2)) var(--full-page-grid-margin);
      }
    }

    &.media-with-content--narrow.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc((var(--full-page-grid-central-column-width) / 3) * 2)
          calc(var(--full-page-grid-central-column-width) / 3) var(--full-page-grid-margin);
      }
    }

    &.media-with-content--narrow {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: var(--full-page-grid-margin)
          calc(var(--full-page-grid-central-column-width) / 3)
          calc((var(--full-page-grid-central-column-width) / 3) * 2) var(--full-page-grid-margin);
      }
    }
  }

  .section--full-width {
    &.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 2.5fr 3.5fr;

        grid-template-areas: 'content media';
      }
    }

    &.media-with-content--medium {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 1fr 1fr;
      }
    }

    &.media-with-content--narrow {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 2fr 4fr;
      }
    }

    &.media-with-content--narrow.media-with-content--media-right {
      @media screen and (min-width: 750px) {
        --media-with-content-grid-columns: 4fr 2fr;
      }
    }
  }

  /* Keep the CSS specificity lower assuming that liquid won't assign this class with a full width section */
  .media-with-content.media-with-content--media-extend {
    grid-template-columns: var(--media-with-content-grid-columns);
    grid-template-areas: 'media media media' 'margin-left content margin-right';

    @media screen and (min-width: 750px) {
      grid-template-areas: 'media media content margin-right';
    }
  }

  .media-with-content--media-extend.media-with-content--media-right {
    @media screen and (min-width: 750px) {
      grid-template-areas: 'margin-left content media media';
    }
  }

  .media-with-content--media-right {
    @media screen and (min-width: 750px) {
      grid-template-areas: 'margin-left content media media';
    }
  }

  .media-with-content {
    --media-with-content-grid-columns: var(--full-page-grid-with-margins);

    grid-template-columns: var(--media-with-content-grid-columns);
    grid-template-areas: 'media media media' 'content content content';

    @media screen and (min-width: 750px) {
      --media-with-content-grid-columns: 3.5fr 2.5fr;
      min-height: var(--media-with-content-section-min-height, auto);

      /* Default desktop layout is wide media, on the left, in full page section */
      grid-template-areas: 'media content';
    }

    .media-block {
      grid-area: media;
    }

    .media-with-content__content {
      grid-area: content;
    }

    /* Inner blocks spacing */
    .media-with-content__content > .group-block-content {
      padding-inline: var(--page-margin);
      padding-block: calc(2 * var(--page-margin));

      @media screen and (min-width: 750px) {
        padding-block: var(--page-margin);
      }
    }

    &.section--page-width .media-with-content__content > .group-block-content {
      padding-inline: 0;

      @media screen and (min-width: 750px) {
        padding-inline-start: var(--page-margin);
      }
    }

    &.section--page-width.media-with-content--media-right .media-with-content__content > .group-block-content {
      padding-inline-end: var(--page-margin);
      padding-inline-start: 0;
    }
  }

  .media-with-content[data-shopify-visual-preview] {
    --hero-min-height: 500px;

    min-height: 500px;
  }

  /* Exact media height — slider value is the picture box, not a min-height */
  .media-with-content--height-fixed .media-block {
    position: relative;
    overflow: hidden;
    width: 100%;

    @media screen and (max-width: 749px) {
      height: var(--media-height-mobile);
      min-height: var(--media-height-mobile);
      max-height: var(--media-height-mobile);
    }

    @media screen and (min-width: 750px) {
      height: var(--media-height);
      min-height: var(--media-height);
      max-height: var(--media-height);
    }
  }

  .media-with-content--height-fixed .media-block__media,
  .media-with-content--height-fixed .media-block__media-link,
  .media-with-content--height-fixed deferred-media.media-block__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: var(--image-position, cover);
    object-position: center center;
  }

  .media-with-content--height-fixed .media-block__media-link {
    display: block;
  }

  .media-with-content--height-fixed .media-block__media-link .media-block__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .media-with-content--media-framed .media-block {
    overflow: hidden;
    width: 100%;
    padding: 0;

    @media screen and (max-width: 749px) {
      margin-inline: var(--media-with-content-media-inset-mobile);
      margin-block: var(--media-with-content-media-inset-mobile);
      width: calc(100% - (var(--media-with-content-media-inset-mobile) * 2));
    }

    @media screen and (min-width: 750px) {
      margin-inline: var(--media-with-content-media-inset);
      margin-block: var(--media-with-content-media-inset);
      width: calc(100% - (var(--media-with-content-media-inset) * 2));
    }
  }

  .media-with-content--width-custom-desktop .media-block {
    @media screen and (min-width: 750px) {
      width: var(--media-with-content-media-width);
      max-width: 100%;
      justify-self: start;
    }
  }

  .media-with-content--width-custom-desktop.media-with-content--media-right .media-block {
    @media screen and (min-width: 750px) {
      justify-self: end;
    }
  }

  .media-with-content--width-custom-desktop.media-with-content--media-framed .media-block {
    @media screen and (min-width: 750px) {
      width: var(--media-with-content-media-width);
      max-width: calc(100% - (var(--media-with-content-media-inset) * 2));
    }
  }

  .media-with-content--width-custom-mobile .media-block {
    @media screen and (max-width: 749px) {
      width: var(--media-with-content-media-width-mobile);
      max-width: 100%;
      justify-self: center;
    }
  }

  .media-with-content--width-custom-mobile.media-with-content--media-framed .media-block {
    @media screen and (max-width: 749px) {
      width: var(--media-with-content-media-width-mobile);
      max-width: calc(100% - (var(--media-with-content-media-inset-mobile) * 2));
    }
  }

  .media-with-content--media-framed .media-block__media,
  .media-with-content--media-framed .media-block__media-link,
  .media-with-content--media-framed deferred-media.media-block__media {
    border-radius: var(--media-with-content-media-radius);
    overflow: hidden;
  }

  .media-with-content--media-framed:not(.media-with-content--height-fixed) .media-block__media,
  .media-with-content--media-framed:not(.media-with-content--height-fixed) deferred-media.media-block__media {
    @media screen and (min-width: 750px) {
      position: relative;
      height: 100%;
    }
  }

  .media-with-content--media-framed:not(.media-with-content--height-fixed) .media-block__media-link {
    @media screen and (min-width: 750px) {
      position: relative;
      display: block;
      height: 100%;
    }
  }

  .media-with-content--align-center {
    @media screen and (min-width: 750px) {
      min-height: var(--media-with-content-section-min-height, var(--media-height));
      align-items: center;
    }
  }

  .media-with-content--height-custom.media-with-content--align-center {
    @media screen and (min-width: 750px) {
      min-height: unset;
    }
  }

  .media-with-content--height-custom .media-block {
    @media screen and (min-width: 750px) {
      align-self: center;
    }
  }

  .media-with-content--align-center.media-with-content--media-framed .media-block {
    @media screen and (min-width: 750px) {
      align-self: center;
    }
  }

  .media-with-content--align-center .media-with-content__content {
    @media screen and (min-width: 750px) {
      align-self: center;
    }
  }

  .media-with-content--align-center .media-with-content__content > .group-block-content {
    @media screen and (min-width: 750px) {
      padding-block: var(--media-with-content-media-inset, var(--page-margin));
    }
  }

  .media-with-content--custom-button-radius .media-with-content__content :is(.button, .button-custom) {
    border-radius: var(--media-with-content-button-radius);
  }

  /* Adaptive: natural media height as floor, stretch with taller content */
  .media-with-content--height-adaptive {
    @media screen and (min-width: 750px) {
      align-items: stretch;

      .media-block {
        display: grid;
        min-height: unset;
        height: auto;
        align-self: stretch;
      }

      .media-block__media,
      .media-block__media-link,
      deferred-media.media-block__media {
        grid-area: 1 / 1;
        position: relative;
        inset: auto;
        width: 100%;
        height: auto;
        min-height: 100%;
        align-self: stretch;
        object-fit: cover;
      }

      .media-block__media-link {
        display: grid;
        height: 100%;
      }

      .media-block__media-link .media-block__media {
        height: auto;
        min-height: 100%;
      }
    }
  }

  .media-with-content--height-adaptive.media-with-content--media-framed .media-block {
    @media screen and (min-width: 750px) {
      height: auto;
      max-height: none;
    }
  }

  .shopify-section:has(.media-with-content.color-custom) > .section-background[style*='linear-gradient'] {
    background-color: transparent;
  }

  .media-with-content--content-panel-bg .media-with-content__content {
    background-color: var(--content-panel-bg);
  }

  .media-with-content--content-max-width .media-with-content__content > .group-block-content {
    max-width: var(--content-max-width);
    width: 100%;
    margin-inline: auto;
  }

  .media-with-content--align-desktop-left .media-with-content__content > .group-block-content {
    @media screen and (min-width: 750px) {
      align-items: flex-start;
      text-align: left;
      margin-inline: 0;
    }
  }

  .media-with-content--align-desktop-center .media-with-content__content > .group-block-content {
    @media screen and (min-width: 750px) {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }
  }

  .media-with-content--align-desktop-right .media-with-content__content > .group-block-content {
    @media screen and (min-width: 750px) {
      align-items: flex-end;
      text-align: right;
      margin-inline-start: auto;
      margin-inline-end: 0;
    }
  }

  .media-with-content--align-mobile-left .media-with-content__content > .group-block-content {
    @media screen and (max-width: 749px) {
      align-items: flex-start;
      text-align: left;
    }
  }

  .media-with-content--align-mobile-center .media-with-content__content > .group-block-content {
    @media screen and (max-width: 749px) {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }
  }

  .media-with-content--heading-mobile .media-with-content__content :is(h2, .h2) {
    @media screen and (max-width: 749px) {
      font-size: var(--media-with-content-heading-mobile);
      --font-size: var(--media-with-content-heading-mobile);
    }
  }

  .media-with-content--scale-typography .media-with-content__content :is(h2, .h2) {
    color: var(--spotlight-heading-color);
    font-weight: 700;
    line-height: var(--spotlight-heading-line-height);
  }

  .media-with-content--scale-typography .media-with-content__content .text-block:first-child {
    letter-spacing: var(--spotlight-eyebrow-letter-spacing);
    text-transform: uppercase;
  }

  .media-with-content--custom-content-padding .media-with-content__content > .group-block-content {
    padding-block-start: var(--padding-top);
    padding-block-end: var(--padding-bottom);
    padding-inline-start: var(--padding-left);
    padding-inline-end: var(--padding-right);
  }

  @media screen and (max-width: 990px) {
    .media-with-content--custom-content-padding .media-with-content__content > .group-block-content {
      padding-block-start: var(--padding-top-tablet);
      padding-block-end: var(--padding-bottom-tablet);
      padding-inline-start: var(--padding-left-tablet);
      padding-inline-end: var(--padding-right-tablet);
    }

    .media-with-content--scale-typography .media-with-content__content :is(h2, .h2) {
      font-size: var(--spotlight-heading-size-tablet);
      --font-size: var(--spotlight-heading-size-tablet);
    }

    .media-with-content--scale-typography
      .group-block--stats
      > .group-block-content
      > *
      .group-block-content
      > :first-child
      .text-block {
      font-size: var(--spotlight-stat-size-tablet);
      --font-size: var(--spotlight-stat-size-tablet);
    }
  }

  @media screen and (max-width: 749px) {
    .media-with-content--custom-content-padding .media-with-content__content > .group-block-content {
      padding-block-start: var(--padding-top-mobile);
      padding-block-end: var(--padding-bottom-mobile);
      padding-inline-start: var(--padding-left-mobile);
      padding-inline-end: var(--padding-right-mobile);
    }

    .media-with-content--scale-typography .media-with-content__content :is(h2, .h2) {
      font-size: var(--spotlight-heading-size-mobile);
      --font-size: var(--spotlight-heading-size-mobile);
    }

    .media-with-content--scale-typography
      .group-block--stats
      > .group-block-content
      > *
      .group-block-content
      > :first-child
      .text-block {
      font-size: var(--spotlight-stat-size-mobile);
      --font-size: var(--spotlight-stat-size-mobile);
    }
  }

  @media screen and (min-width: 991px) {
    .media-with-content--scale-typography .media-with-content__content :is(h2, .h2) {
      font-size: var(--spotlight-heading-size);
      --font-size: var(--spotlight-heading-size);
    }

    .media-with-content--scale-typography
      .group-block--stats
      > .group-block-content
      > *
      .group-block-content
      > :first-child
      .text-block {
      font-size: var(--spotlight-stat-size);
      --font-size: var(--spotlight-stat-size);
    }
  }
