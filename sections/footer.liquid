
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign total_blocks = section.blocks.size
  assign grid_columns = total_blocks | at_most: 4
  assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
  assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

  assign has_isolated_grid_item_desktop = false
  assign has_isolated_grid_item_tablet = false

  if total_blocks > 4 and last_row_count == 1
    assign has_isolated_grid_item_desktop = true
  endif

  if total_blocks == 5
    assign has_isolated_grid_item_tablet = true
  endif

  assign tablet_cols = section.settings.tablet_columns | default: 2 | plus: 0
  assign mobile_cols = section.settings.mobile_columns | default: 1 | plus: 0
  if tablet_cols < 1
    assign tablet_cols = 2
  endif
  if mobile_cols < 1
    assign mobile_cols = 1
  endif
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --footer-gap: {{ section.settings.gap }}px;
    --footer-min-height: {{ section.settings.min_height }}px;
    --footer-tablet-columns: {{ tablet_cols }};
    --footer-mobile-columns: {{ mobile_cols }};
    --grid-columns: {{ grid_columns }};
    --last-row-count: {{ last_row_count }};
    --tablet-last-row-count: {{ tablet_last_row_count }};
    {% if section.settings.menu_heading_size > 0 %}
      --footer-menu-heading-size: {{ section.settings.menu_heading_size }}px;
    {% endif %}
    {% if section.settings.menu_link_size > 0 %}
      --footer-menu-link-size: {{ section.settings.menu_link_size }}px;
    {% endif %}
    {% if section.settings.subtitle_letter_spacing > 0 %}
      --letter-spacing--body-loose: {{ section.settings.subtitle_letter_spacing }}px;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .footer-content {
    min-height: var(--footer-min-height, 0);
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .footer-content > * {
    min-width: 0;
    max-width: 100%;
  }

  {% if section.settings.menu_heading_size > 0 %}
    #shopify-section-{{ section.id }} .menu__heading {
      font-size: var(--footer-menu-heading-size);
      font-weight: 700;
      letter-spacing: 0.6px;
    }
  {% endif %}

  {% if section.settings.menu_link_size > 0 %}
    #shopify-section-{{ section.id }} .menu__item,
    #shopify-section-{{ section.id }} .menu__item a {
      font-size: var(--footer-menu-link-size);
      font-weight: 400;
    }
  {% endif %}

  #shopify-section-{{ section.id }} .text-block.custom-typography[style*='--font-heading--family'] {
    font-family: var(--font-heading--family), serif;
  }
{% endstyle %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
>
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
      {% if section.settings.columns_ratio == 'newsletter_wide' %}footer-content--newsletter-wide{% endif %}
      {% if section.settings.mobile_layout == 'two_col_menus' %}footer-content--mobile-two-col{% endif %}
      {% if section.settings.hide_media_on_mobile %}footer-content--hide-media-mobile{% endif %}
    "
    style="
      {% render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
      --footer-tablet-columns: {{ tablet_cols }};
      --footer-mobile-columns: {{ mobile_cols }};
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: repeat(var(--footer-mobile-columns, 1), minmax(0, 1fr));
    gap: var(--footer-gap);
    align-items: start;
    overflow-wrap: anywhere;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(var(--footer-tablet-columns, 2), minmax(0, 1fr));
      grid-auto-flow: row;
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    }

    .footer-content--newsletter-wide[style*='--grid-columns: 4'] {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    }

    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .footer-content {
      min-height: 0;
    }

    .footer-content .menu .menu__details {
      padding-inline: 0;
    }

    .footer-content--hide-media-mobile .logo-block,
    .footer-content--hide-media-mobile .image-block {
      display: none;
    }

    .footer-content--mobile-two-col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 40px;
      align-items: start;
    }

    .footer-content--mobile-two-col .menu--links-plain .menu__item a {
      color: #ffffff;
    }

    .footer-content--mobile-two-col > .group-block,
    .footer-content--mobile-two-col > .logo-block {
      grid-column: 1 / -1;
    }

    .footer-content--mobile-two-col > .menu:last-child {
      grid-column: 1 / -1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "social-links"
    },
    {
      "type": "email-signup"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "columns_ratio",
      "label": "Column ratio",
      "options": [
        {
          "value": "equal",
          "label": "Equal"
        },
        {
          "value": "newsletter_wide",
          "label": "Wide first column"
        }
      ],
      "default": "equal"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 0,
      "info": "0 keeps auto height. Use ~480–520 with padding for a ~575px desktop footer."
    },
    {
      "type": "select",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "default",
          "label": "Match column count"
        },
        {
          "value": "two_col_menus",
          "label": "Two-column menus"
        }
      ],
      "default": "default",
      "info": "Two-column menus: first group full width, COMPANY | POLICIES, last menu full width. Desktop is unchanged."
    },
    {
      "type": "checkbox",
      "id": "hide_media_on_mobile",
      "label": "Hide logo and images on mobile",
      "default": false
    },
    {
      "type": "range",
      "id": "menu_heading_size",
      "label": "Menu heading size",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses the menu heading preset. 12 matches the Figma footer."
    },
    {
      "type": "range",
      "id": "menu_link_size",
      "label": "Menu link size",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "0 uses the menu link preset. 14 matches the Figma footer."
    },
    {
      "type": "range",
      "id": "subtitle_letter_spacing",
      "label": "Subtitle letter spacing",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0,
      "info": "Applies to body loose tracking inside this footer. 1px ≈ .05em at 12px."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "t:names.footer",
      "category": "t:categories.footer",
      "settings": {
        "gap": 20,
        "padding-block-start": 36,
        "padding-block-end": 36
      },
      "blocks": {
        "newsletter-group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "vertical_on_mobile": true,
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "gap": 6,
            "width": "fill"
          },
          "blocks": {
            "newsletter-heading": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.join_our_email_list",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h3"
              }
            },
            "newsletter-text": {
              "type": "text",
              "settings": {
                "text": "t:html_defaults.get_exclusive_deals_and_early_access_to_new_products",
                "width": "100%",
                "alignment": "left",
                "type_preset": "rte"
              }
            }
          },
          "block_order": ["newsletter-heading", "newsletter-text"]
        },
        "newsletter-form": {
          "type": "email-signup",
          "settings": {
            "width": "fill"
          }
        }
      },
      "block_order": ["newsletter-group", "newsletter-form"]
    }
  ]
}
{% endschema %}
