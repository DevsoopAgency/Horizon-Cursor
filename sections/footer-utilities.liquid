
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign utilities_layout = section.settings.layout | default: 'auto'
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --utilities-gap: {{ section.settings.gap }}px;
    --border-width: {{ section.settings.divider_thickness }}px;
    {% if section.settings.divider_color != blank %}
      --divider-color: {{ section.settings.divider_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }} .utilities {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .utilities--layout-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--utilities-gap);
  }

  #shopify-section-{{ section.id }} .utilities--layout-space-between {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    gap: var(--utilities-gap);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .utilities--layout-space-between {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--utilities-gap);
    }

    #shopify-section-{{ section.id }} .utilities--layout-space-between > *:last-child {
      margin-inline-start: auto;
      text-align: right;
      justify-self: end;
    }
  }
{% endstyle %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  {{ section.shopify_attributes }}
>
  <div
    class="
      utilities
      utilities--blocks-{{ section.blocks.size }}
      utilities--layout-{{ utilities_layout }}
      spacing-style
    "
    style="{% render 'spacing-style', settings: section.settings %} --border-width: {{ section.settings.divider_thickness }}px;{% if section.settings.divider_color != blank %} --divider-color: {{ section.settings.divider_color }};{% endif %} --gap: {{ section.settings.gap }}px;"
    data-testid="footer-utilities"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .utilities {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
    border-top: var(--border-width) solid var(--divider-color, var(--color-border));
    color: var(--color-foreground-muted);
    overflow-wrap: anywhere;
  }

  .utilities a,
  .utilities button {
    color: var(--color-utilities, var(--color-foreground-muted));
  }

  .utilities > * {
    text-align: left;
    max-width: 100%;
    min-width: 0;
  }

  /* Legacy auto layout (preserves stock Horizon when layout = auto) */
  .utilities--layout-auto {
    align-items: center;
    text-wrap: wrap;
  }

  .utilities--layout-auto > * {
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .utilities--layout-auto {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      justify-content: center;
      gap: var(--gap);
      align-items: center;
      text-align: left;
    }

    .utilities--layout-auto > * {
      text-align: left;
      justify-self: start;
    }

    .utilities--layout-auto.utilities--blocks-1 {
      grid-template-columns: 1fr;
      justify-content: start;
    }

    .utilities--layout-auto.utilities--blocks-1 > * {
      justify-self: start;
      text-align: left;
    }

    .utilities--layout-auto.utilities--blocks-2 {
      grid-template-columns: 1fr 1fr;
    }

    .utilities--layout-auto.utilities--blocks-2 > *:nth-child(2) {
      justify-self: end;
      text-align: right;
    }

    .utilities--layout-auto.utilities--blocks-3 {
      grid-template-columns: 1fr auto 1fr;
    }

    .utilities--layout-auto.utilities--blocks-3 > *:nth-child(2) {
      justify-self: center;
      text-align: center;
    }

    .utilities--layout-auto.utilities--blocks-3 > *:nth-child(3) {
      justify-self: end;
      text-align: right;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.policies_and_links",
  "tag": "div",
  "class": "footer-utilities",
  "max_blocks": 3,
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "auto",
          "label": "t:options.default"
        },
        {
          "value": "space-between",
          "label": "Space between"
        },
        {
          "value": "stack",
          "label": "Stack"
        }
      ],
      "default": "auto",
      "info": "Space between: copyright left, links right on desktop; stacks on mobile."
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "range",
      "id": "divider_thickness",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "visible_if": "{{ section.settings.divider_thickness > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "footer-copyright"
    },
    {
      "type": "footer-policy-list"
    },
    {
      "type": "social-links"
    }
  ],
  "presets": [
    {
      "name": "t:names.policies_and_links",
      "category": "t:categories.footer",
      "blocks": {
        "copyright": {
          "type": "footer-copyright"
        },
        "policy_list": {
          "type": "footer-policy-list"
        },
        "social_icons": {
          "type": "social-links"
        }
      },
      "block_order": ["copyright", "policy_list", "social_icons"]
    }
  ]
}
{% endschema %}
