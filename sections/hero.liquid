

{% liquid
  assign media_count = 0
  assign media_count_mobile = 0
  assign fallback_to_desktop = false
  assign media_1 = 'none'
  assign media_2 = 'none'
  assign media_1_mobile = 'none'
  assign media_2_mobile = 'none'
  assign has_only_video = false
  assign has_only_video_mobile = false

  # Desktop media checks
  # For each media slot, check if the media is not blank and the media type matches the slot
  # Need to check both (1) media picker is not blank AND (2) section.setting.media_type because user can toggle between different media types to display, but choosing "Image" doesn't clear a saved "Video" in the theme editor.
  # The alternate setting (section.settings.image_1 when "Video" is selected) is only visually hidden in theme editor.
  if section.settings.image_1 != blank and section.settings.media_type_1 == 'image'
    assign media_1 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.video_1 != blank and section.settings.media_type_1 == 'video'
    assign media_1 = 'video'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.image_2 != blank and section.settings.media_type_2 == 'image'
    assign media_2 = 'image'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.video_2 != blank and section.settings.media_type_2 == 'video'
    assign media_2 = 'video'
    assign media_count = media_count | plus: 1
  endif

  if section.settings.custom_mobile_media
    # Mobile media checks
    # For each media slot, check if the media is not blank and the media type matches the slot
    if section.settings.image_1_mobile != blank and section.settings.media_type_1_mobile == 'image'
      assign media_1_mobile = 'image'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
    if section.settings.video_1_mobile != blank and section.settings.media_type_1_mobile == 'video'
      assign media_1_mobile = 'video'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
    if section.settings.image_2_mobile != blank and section.settings.media_type_2_mobile == 'image'
      assign media_2_mobile = 'image'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
    if section.settings.video_2_mobile != blank and section.settings.media_type_2_mobile == 'video'
      assign media_2_mobile = 'video'
      assign media_count_mobile = media_count_mobile | plus: 1
    endif
  endif
  if media_count > 0 and media_1 != 'image' and media_2 != 'image'
    assign has_only_video = true
  endif
  if media_count > 0 and media_count_mobile > 0 and media_1_mobile != 'image' and media_2_mobile != 'image'
    assign has_only_video_mobile = true
  endif

  assign media_wrapper_desktop_class = 'hero__media-wrapper hero__media-wrapper--desktop'
  assign media_wrapper_mobile_class = 'hero__media-wrapper hero__media-wrapper--mobile'
  # If there is no custom mobile media to show, we add the mobile class to the desktop classes so content is always shown on mobile.
  if section.settings.custom_mobile_media == false or section.settings.custom_mobile_media == true and media_count_mobile == 0
    assign media_wrapper_desktop_class = media_wrapper_desktop_class | append: ' hero__media-wrapper--mobile'
  endif

  # Should we show the blurred reflection on mobile?
  assign show_mobile_blurred_reflection = false
  if section.settings.blurred_reflection
    if section.settings.custom_mobile_media == true and media_count_mobile > 0 and has_only_video_mobile == false
      # Custom mobile media is active and a mobile image is present
      assign show_mobile_blurred_reflection = true
    elsif section.settings.custom_mobile_media == true and media_count_mobile == 0 and media_count > 0 and has_only_video == false
      # Custom mobile media is active, no mobile media is present, but a desktop image is present
      assign show_mobile_blurred_reflection = true
    elsif section.settings.custom_mobile_media == false and media_count > 0 and has_only_video == false
      # Custom mobile media is inactive, but a desktop image is present
      assign show_mobile_blurred_reflection = true
    endif
  endif

  if media_1 == 'image' and media_2 == 'image'
    assign media_width_desktop = '50vw'
  else
    assign media_width_desktop = '100vw'
  endif

  # If custom mobile media is disabled or no mobile media is present, we need to fallback to desktop media.
  if section.settings.custom_mobile_media == false or media_count_mobile == 0 or media_count == 0
    assign media_count_mobile = media_count
    assign fallback_to_desktop = true
  endif

  if fallback_to_desktop
    assign media_width_mobile = media_width_desktop
  elsif section.settings.stack_media_on_mobile or media_1_mobile != 'image' or media_2_mobile != 'image'
    assign media_width_mobile = '100vw'
  else
    assign media_width_mobile = '50vw'
  endif

  assign sizes = '(min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '832, 1200, 1600, 1920, 2560, 3840'
  assign sizes_mobile = media_width_mobile
  assign mobile_widths = '416, 600, 800, 1200, 1600'
  assign mobile_widths_array = mobile_widths | split: ', '

  assign fetch_priority = 'auto'

  if section.index == 1
    assign fetch_priority = 'high'
  endif

  assign hero_media_aspect_ratio = blank
  if media_1 == 'image' and section.settings.image_1 != blank
    assign hero_media_aspect_ratio = section.settings.image_1.aspect_ratio
  elsif media_1 == 'video' and section.settings.video_1 != blank
    assign hero_media_aspect_ratio = section.settings.video_1.aspect_ratio
  elsif media_2 == 'image' and section.settings.image_2 != blank
    assign hero_media_aspect_ratio = section.settings.image_2.aspect_ratio
  elsif media_2 == 'video' and section.settings.video_2 != blank
    assign hero_media_aspect_ratio = section.settings.video_2.aspect_ratio
  endif
%}

{% capture media_slot_1 %}
  {%- if media_1 == 'image' and media_1_mobile == 'image' -%}
    {%- comment -%} Both desktop and mobile are images. Assume similar images, and this is art direction: use picture element. {%- endcomment -%}
    <div class="hero__media-wrapper">
      <picture
        data-testid="hero-picture-1"
        class="hero__media"
      >
        <source
          media="(max-width: 749px)"
          srcset="
            {%-  for mobile_width in mobile_widths_array -%}
              {{ section.settings.image_1_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          "
          sizes="{{ sizes_mobile }}"
          width="{{ section.settings.image_1_mobile.width }}"
          height="{{ section.settings.image_1_mobile.height }}"
        >
        {{
          section.settings.image_1
          | image_url: width: 3840
          | image_tag:
            width: section.settings.image_1.width,
            widths: widths,
            height: section.settings.image_1.height,
            alt: section.settings.image_1.alt,
            class: 'hero__media',
            sizes: sizes,
            fetchpriority: fetch_priority,
            data-testid: 'hero-desktop-image-1'
        }}
      </picture>
    </div>
  {%- elsif media_1 == 'image' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.image_1
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_1.width,
          widths: widths,
          height: section.settings.image_1.height,
          alt: section.settings.image_1.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-1'
      }}
    </div>
  {%- endif -%}

  {%- if media_1 == 'video' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.video_1
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'hero__media',
          data-testid: 'hero-desktop-video-1'
      }}
    </div>
  {%- endif -%}

  {%- comment -%} Mobile-only slot 1 media (when desktop is different type) {%- endcomment -%}
  {%- if media_count > 0 and media_count_mobile > 0 -%}
    {%- if media_1_mobile == 'image' and media_1 != 'image' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag:
            width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: section.settings.image_1_mobile.alt,
            class: 'hero__media',
            sizes: sizes_mobile,
            fetchpriority: fetch_priority,
            data-testid: 'hero-mobile-image-1'
        }}
      </div>
    {%- endif -%}

    {%- if media_1_mobile == 'video' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.video_1_mobile
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            class: 'hero__media',
            data-testid: 'hero-mobile-video-1'
        }}
      </div>
    {%- endif -%}
  {%- endif -%}
{% endcapture %}

{% capture media_slot_2 %}
  {%- if media_2 == 'image' and media_2_mobile == 'image' -%}
    {%- comment -%} Both desktop and mobile are images. Assume this is art direction: use picture element.  {%- endcomment -%}
    <div class="hero__media-wrapper">
      <picture
        class="hero__media"
        data-testid="hero-picture-2"
      >
        <source
          media="(max-width: 749px)"
          srcset="
            {%-  for mobile_width in mobile_widths_array -%}
              {{ section.settings.image_2_mobile | image_url: width: mobile_width }} {{ mobile_width }}w{% unless forloop.last%},{% endunless %}
            {%- endfor -%}
          "
          sizes="{{ sizes_mobile }}"
          width="{{ section.settings.image_2_mobile.width }}"
          height="{{ section.settings.image_2_mobile.height }}"
        >
        {{
          section.settings.image_2
          | image_url: width: 3840
          | image_tag:
            width: section.settings.image_2.width,
            widths: widths,
            height: section.settings.image_2.height,
            alt: section.settings.image_2.alt,
            class: 'hero__media',
            sizes: sizes,
            fetchpriority: fetch_priority,
            data-testid: 'hero-desktop-image-2'
        }}
      </picture>
    </div>
  {%- elsif media_2 == 'image' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.image_2
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image_2.width,
          widths: widths,
          height: section.settings.image_2.height,
          alt: section.settings.image_2.alt,
          class: 'hero__media',
          sizes: sizes,
          fetchpriority: fetch_priority,
          data-testid: 'hero-desktop-image-2'
      }}
    </div>
  {%- endif -%}

  {%- if media_2 == 'video' -%}
    <div class="{{ media_wrapper_desktop_class }}">
      {{
        section.settings.video_2
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'hero__media',
          data-testid: 'hero-desktop-video-2'
      }}
    </div>
  {%- endif -%}

  {%- comment -%} Mobile-only slot 2 media (when desktop is different type) {%- endcomment -%}
  {%- if media_count > 0 and media_count_mobile > 0 -%}
    {%- if media_2_mobile == 'image' and media_2 != 'image' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag:
            width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: section.settings.image_2_mobile.alt,
            class: 'hero__media',
            sizes: sizes_mobile,
            fetchpriority: fetch_priority,
            data-testid: 'hero-mobile-image-2'
        }}
      </div>
    {%- endif -%}

    {%- if media_2_mobile == 'video' -%}
      <div class="{{ media_wrapper_mobile_class }}">
        {{
          section.settings.video_2_mobile
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            class: 'hero__media',
            data-testid: 'hero-mobile-video-2'
        }}
      </div>
    {%- endif -%}
  {%- endif -%}
{% endcapture %}

{% capture media %}
  {{ media_slot_1 }}
  {{ media_slot_2 }}

  {% if media_count == 0 %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
  {%- endif -%}
{% endcapture %}

{% capture media_blurred %}
  {% if media_1 == 'image' %}
    {{
      section.settings.image_1
      | image_url: width: 3840
      | image_tag:
        width: section.settings.image_1.width,
        widths: widths,
        height: section.settings.image_1.height,
        alt: '',
        class: 'hero__media',
        sizes: sizes
    }}
  {% endif %}
  {% if media_2 == 'image' %}
    {{
      section.settings.image_2
      | image_url: width: 3840
      | image_tag:
        width: section.settings.image_2.width,
        widths: widths,
        height: section.settings.image_2.height,
        alt: '',
        class: 'hero__media',
        sizes: sizes
    }}
  {% endif %}
  {% if media_count == 0 %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
  {% endif %}
{% endcapture %}

{% capture mobile_media_blurred %}
  {%- comment -%}
    On mobile we need to check:
    1. If the media should be stacked. If it is,we check for the second (bottom) image first, then for the first (top) image.
    2. If custom mobile setting is active and has media (show desktop media otherwise).
  {%- endcomment -%}
  {% if section.settings.stack_media_on_mobile == false %}
    {% if section.settings.custom_mobile_media == true and fallback_to_desktop == false %}
      {% if media_1_mobile == 'image' %}
        {{ section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
      {% if media_2_mobile == 'image' %}
        {{ section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
    {% elsif fallback_to_desktop %}
      {{ media_blurred }}
    {% endif %}
  {% elsif section.settings.stack_media_on_mobile == true %}
    {% if section.settings.custom_mobile_media == true and fallback_to_desktop == false %}
      {% if media_2_mobile == 'image' %}
        {{ section.settings.image_2_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_2_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_2_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
        }}
      {% elsif media_1_mobile == 'image' %}
        {{ section.settings.image_1_mobile
          | image_url: width: 1600
          | image_tag: width: section.settings.image_1_mobile.width,
            widths: mobile_widths,
            height: section.settings.image_1_mobile.height,
            alt: '',
            class: 'hero__media',
            sizes: sizes_mobile
          }}
      {% endif %}
    {% elsif fallback_to_desktop %}
      {% if media_count > 0 %}
        {% if media_2 == 'image' %}
          {{ section.settings.image_2
            | image_url: width: 1600
            | image_tag: width: section.settings.image_2.width,
              widths: widths,
              height: section.settings.image_2.height,
              alt: '',
              class: 'hero__media',
              sizes: sizes
            }}
        {% elsif media_1 == 'image' %}
          {{ section.settings.image_1
            | image_url: width: 1600
            | image_tag: width: section.settings.image_1.width,
              widths: widths,
              height: section.settings.image_1.height,
              alt: '',
              class: 'hero__media',
              sizes: sizes
            }}
        {% endif %}
        {% if media_count == 0 %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
        {% endif %}
      {% endif %}
    {% endif %}
  {% endif %}
{% endcapture %}

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif

  assign has_banner_content = false
  for block in section.blocks
    if block.type == 'banner-content'
      assign has_banner_content = true
    endif
  endfor
-%}

<div
  id="Hero-{{ section.id }}"
  class="
    hero
    {% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}
    {% if section.blocks.size == 0 and section.settings.section_height == 'auto' %} hero--no-blocks-auto-height{% endif %}
    {% if section.settings.section_height == 'adaptive' %} hero--height-adaptive{% endif %}
    {% if section.settings.stack_media_on_mobile %} hero--stack-mobile{% endif %}
    {% if section.settings.mobile_content_layout == 'stack' %} hero--stack-content-mobile{% endif %}
    {% if media_count == 2 %} hero--dual-media{% endif %}
    {% if has_banner_content %} hero--has-banner{% endif %}
    hero--mobile-height-{{ section.settings.mobile_height | default: 'adapt' }}
  "
  style="
    --hero-border-style: {{ section.settings.border }};
    --hero-border-width: {{ section.settings.border_width }}px;
    --hero-border-opacity: {{ section.settings.border_opacity }}%;
    --blur-opacity: {{ section.settings.reflection_opacity | divided_by: 100.0 }};
    --hero-mobile-stack-pad-top: {{ section.settings.mobile_stack_padding_top | default: 48 }}px;
    --hero-mobile-stack-pad-bottom: {{ section.settings.mobile_stack_padding_bottom | default: 16 }}px;
    --hero-mobile-stack-pad-inline: {{ section.settings.mobile_stack_padding_inline | default: 24 }}px;
    --hero-mobile-stack-gap: {{ section.settings.mobile_stack_gap | default: 8 }}px;
    --hero-overlay-pad-top-mobile: {{ section.settings.mobile_overlay_pad_top | default: 0 }}px;
    --hero-overlay-pad-inline-mobile: {{ section.settings.mobile_overlay_pad_inline | default: 0 }}px;
    --hero-overlay-reserve-bottom: {{ section.settings.mobile_overlay_reserve_bottom | default: 0 }}%;
    --hero-mobile-media-fit: {{ section.settings.mobile_media_fit | default: 'cover' }};
    --hero-mobile-media-position: {{ section.settings.mobile_media_position | default: 'center center' }};
    --hero-content-safe-inset: max(var(--page-margin, 1rem), 1.5rem);
    {% if section.settings.section_height == 'custom' %}
      --hero-min-height: {{ section.settings.section_height_custom }}svh;
    {% elsif section.settings.section_height == "full-screen" %}
       --hero-min-height: 100svh;
    {% elsif section.settings.section_height == 'adaptive' or section.settings.section_height == 'auto' %}
      --hero-min-height: auto;
    {% else %}
      --hero-min-height: var(--section-height-{{ section.settings.section_height }});
    {% endif %}
    {% if section.settings.mobile_height == 'small' or section.settings.mobile_height == 'medium' or section.settings.mobile_height == 'large' %}
      --hero-min-height-mobile: var(--section-height-{{ section.settings.mobile_height }});
    {% else %}
      --hero-min-height-mobile: auto;
    {% endif %}
    {% if hero_media_aspect_ratio != blank %}--hero-media-aspect-ratio: {{ hero_media_aspect_ratio }};{% endif %}
  "
  {% if request.visual_preview_mode %}
    data-shopify-visual-preview
  {% endif %}
  {% if section.settings.blurred_reflection and has_only_video == false or has_only_video_mobile == false %}
    data-blur-shadow="true"
  {% endif %}
>
  {% style %}
    #Hero-{{ section.id }} {
      --hero-content-safe-inset: max(var(--page-margin, 1rem), 1.5rem);
    }

    @media screen and (min-width: 750px) and (max-width: 989px) {
      #Hero-{{ section.id }} {
        --hero-content-safe-inset: max(var(--page-margin, 1rem), 1.25rem);
      }
    }

    @media screen and (min-width: 990px) {
      #Hero-{{ section.id }} {
        --hero-content-safe-inset: max(var(--page-margin, 1rem), 2rem);
      }
    }

    @media screen and (max-width: 749px) {
      {% if section.settings.mobile_overlay_pad_inline > 0 %}
        #Hero-{{ section.id }} {
          --hero-content-safe-inset: {{ section.settings.mobile_overlay_pad_inline }}px;
        }
      {% endif %}

      {% if section.settings.mobile_content_layout != 'stack' %}
        #Hero-{{ section.id }} .hero__media {
          object-fit: var(--hero-mobile-media-fit, cover);
          object-position: var(--hero-mobile-media-position, center center);
        }

        {% if section.settings.mobile_overlay_pad_top > 0 %}
          #Hero-{{ section.id }} .banner-content--mobile-pos-top .banner-content__slot {
            top: {{ section.settings.mobile_overlay_pad_top }}px !important;
          }
        {% endif %}

        {% if section.settings.mobile_overlay_reserve_bottom > 0 %}
          #Hero-{{ section.id }} .banner-content--mobile-pos-top .banner-content__slot,
          #Hero-{{ section.id }} .banner-content--mobile-pos-custom .banner-content__slot {
            bottom: {{ section.settings.mobile_overlay_reserve_bottom }}% !important;
          }

          #Hero-{{ section.id }} .banner-content__inner {
            justify-content: flex-start !important;
            height: 100%;
          }
        {% endif %}
      {% endif %}

      {% if section.settings.mobile_content_layout != 'stack' %}
      {% if section.settings.mobile_height == 'small' or section.settings.mobile_height == 'medium' or section.settings.mobile_height == 'large' %}
        #Hero-{{ section.id }} {
          --hero-min-height-mobile: var(--section-height-{{ section.settings.mobile_height }});
          height: calc(var(--hero-min-height-mobile) - var(--hero-height-offset));
          min-height: calc(var(--hero-min-height-mobile) - var(--hero-height-offset));
        }

        #Hero-{{ section.id }} .hero__container {
          height: 100%;
          min-height: 100%;
        }

        {% if has_banner_content %}
          #Hero-{{ section.id }} .hero__content-wrapper {
            display: block !important;
            position: absolute !important;
            inset: 0 !important;
            height: 100% !important;
            width: 100% !important;
          }

          #Hero-{{ section.id }} .hero__content-wrapper > * {
            position: absolute !important;
            inset: 0 !important;
            height: 100% !important;
            width: 100% !important;
            margin: 0 !important;
          }
        {% endif %}
      {% endif %}
      {% endif %}
    }
  {% endstyle %}

  {% if section.settings.blurred_reflection %}
    {% unless has_only_video %}
      <div
        class="hero__blurred-image hero__blurred-image--desktop"
        data-testid="hero-blurred-image-desktop"
      >
        {{ media_blurred }}
      </div>
    {% endunless %}
    {% if show_mobile_blurred_reflection %}
      <div
        class="hero__blurred-image hero__blurred-image--mobile"
        data-testid="hero-blurred-image-mobile"
      >
        {{ mobile_media_blurred }}
      </div>
    {% endif %}
  {% endif %}

  {% comment %}
    Hardcoded to section--full-width bc the media has to be full width in all cases.
    hero__content-wrapper applies section_width.
  {% endcomment %}

  <div
    class="hero__container spacing-style section section--full-width"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="hero__link"
        {% if section.settings.open_in_new_tab %}
          target="_blank" rel="noopener"
        {% endif %}
      ></a>
    {%- endif -%}
    <div
      class="hero__media-grid{% if media_count == 2 %} hero__media-grid--dual{% endif %}"
      style="--hero-media-count: {{ media_count }};--hero-media-count-mobile: {{ media_count_mobile }};"
      data-media-count="{{ media_count }}"
      data-media-count-mobile="{{ media_count_mobile }}"
      data-testid="hero-media-wrapper"
    >
      {% liquid
        if section.settings.toggle_overlay
          render 'overlay', settings: section.settings
        endif
      %}
      {{ media }}
    </div>
    <div
      class="
        hero__content-wrapper
        layout-panel-flex
        layout-panel-flex--{{ section.settings.content_direction }}
        {% if section.settings.vertical_on_mobile %}mobile-column{% endif %}
        section-content-wrapper
        {{section.settings.section_width}}
        {% if request.design_mode %}hero__content-wrapper--design-mode{% endif %}
      "
      style="{% render 'layout-panel-style', settings: section.settings %}"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero-wrapper {
    --hero-height-offset: 0px;
  }

  /* Being extra specific in the selector for performance reasons */
  body:has(#header-group > .header-section > #header-component) .hero-wrapper:first-child {
    --hero-height-offset: var(--header-group-height, 0);
  }

  .hero {
    position: relative;
    min-height: calc(var(--hero-min-height) - var(--hero-height-offset));
  }

  .hero[data-shopify-visual-preview] {
    --hero-min-height: 600px;

    min-height: 600px;
  }

  .hero__container {
    position: relative;
    overflow: hidden;
    border: var(--hero-border-width) var(--hero-border-style) rgb(var(--color-border-rgb) / var(--hero-border-opacity));
    min-height: inherit;
    align-items: var(--vertical-alignment-mobile);
    justify-content: var(--horizontal-alignment);
    z-index: var(--layer-base);

    @media screen and (min-width: 750px) {
      align-items: var(--vertical-alignment);
    }
  }

  .hero__content-wrapper.page-width {
    grid-column: 2 / 3;
  }

  .hero__content-wrapper {
    position: relative;
    inset: 0;
    z-index: var(--layer-flat);
  }

  /*
    Banner overlay: kill layout-panel-flex centering.
    Shopify wraps the banner in .shopify-block; that wrapper collapses when the
    banner is absolute, then flex justify:center parks the group mid-hero.
    Force wrapper + shopify-block to fill the hero so Top/Middle/Bottom work.
  */
  .hero.hero--has-banner:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper,
  .hero:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper:has(.banner-content) {
    display: block !important;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    z-index: var(--layer-flat);
  }

  .hero.hero--has-banner:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper > *,
  .hero:not(.hero--stack-content-mobile):not(.hero--height-adaptive)
    .hero__content-wrapper:has(.banner-content)
    > * {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    margin: 0 !important;
  }

  /* Overlay without banner-content: still fill section height */
  .hero:not(.hero--has-banner):not(.hero--stack-content-mobile):not(.hero--height-adaptive)
    .hero__content-wrapper:not(:has(.banner-content)) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    z-index: var(--layer-flat);
  }

  .hero__content-wrapper .group-block-content {
    position: relative;
  }

  .hero__media-grid {
    position: absolute;
    inset: 0;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(var(--hero-media-count, 1), minmax(0, 1fr));
    width: 100%;
    height: 100%;
  }

  /* Dual media: equal 50/50 columns — never collapse/overlap image_2 */
  .hero__media-grid--dual,
  .hero__media-grid[data-media-count='2'],
  .hero.hero--dual-media .hero__media-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .hero__media-grid--dual > .hero__media-wrapper,
  .hero__media-grid[data-media-count='2'] > .hero__media-wrapper,
  .hero.hero--dual-media .hero__media-grid > .hero__media-wrapper {
    min-width: 0;
    width: 100%;
    height: 100%;
    flex: 1 1 50%;
  }

  .hero--auto .hero__media {
    aspect-ratio: var(--hero-media-aspect-ratio);
  }

  /* Adaptive: media natural aspect as floor; grow with in-flow content */
  .hero.hero--height-adaptive {
    min-height: unset;
  }

  .hero--height-adaptive .hero__container {
    min-height: unset;
    height: auto;
  }

  .hero--height-adaptive .hero__media-grid,
  .hero--height-adaptive .hero__content-wrapper,
  .hero--height-adaptive .hero__link {
    grid-row: 1;
  }

  .hero--height-adaptive .hero__media-grid {
    position: relative;
    inset: unset;
    aspect-ratio: var(--hero-media-aspect-ratio, auto);
    width: 100%;
    height: auto;
    min-height: 100%;
    align-self: stretch;
  }

  .hero--height-adaptive .hero__media-wrapper {
    position: relative;
    inset: unset;
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  /* Single media still fills the adaptive grid area */
  .hero--height-adaptive:not(.hero--dual-media) .hero__media-wrapper {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  .hero--height-adaptive .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dual adaptive: each cell owns its media — no absolute inset:0 over the full grid */
  .hero--height-adaptive.hero--dual-media .hero__media-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .hero--height-adaptive.hero--dual-media .hero__media-wrapper {
    position: relative;
    inset: unset;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: auto;
  }

  .hero--height-adaptive.hero--dual-media .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero--height-adaptive .hero__content-wrapper {
    position: relative;
    inset: unset;
    z-index: var(--layer-flat);
    /* Override .layout-panel-flex { height: 100% } so content can grow the section */
    height: auto;
    min-height: 100%;
    align-self: stretch;
  }

  .hero--height-adaptive .hero__content-wrapper:has(.banner-content) {
    width: 100%;
    grid-column: 1 / -1;
  }

  /* Banner content must stay in-flow under adaptive or height collapses */
  .hero--height-adaptive .banner-content {
    position: relative;
    inset: auto;
    width: 100%;
    pointer-events: auto;
  }

  .hero--height-adaptive .banner-content__slot {
    position: relative;
    left: auto;
    top: auto;
    transform: none;
    width: min(var(--banner-content-width), calc(100% - (2 * var(--hero-content-safe-inset, 1.5rem))));
    margin-inline-start: clamp(
      var(--hero-content-safe-inset, 1.5rem),
      calc(var(--banner-content-x) - (var(--banner-content-width) / 2)),
      max(
        var(--hero-content-safe-inset, 1.5rem),
        calc(100% - var(--banner-content-width) - var(--hero-content-safe-inset, 1.5rem))
      )
    );
  }

  @media screen and (max-width: 749px) {
    .hero--height-adaptive .banner-content__slot {
      width: min(var(--banner-content-width-mobile), calc(100% - (2 * var(--hero-content-safe-inset, 1.5rem))));
      margin-inline-start: clamp(
        var(--hero-content-safe-inset, 1.5rem),
        calc(var(--banner-content-x-mobile) - (var(--banner-content-width-mobile) / 2)),
        max(
          var(--hero-content-safe-inset, 1.5rem),
          calc(100% - var(--banner-content-width-mobile) - var(--hero-content-safe-inset, 1.5rem))
        )
      );
    }
  }

  /* Tablet: fluid type/gap — no edge-stick, no hard breaks */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .hero {
      --hero-content-safe-inset: max(var(--page-margin, 1rem), 1.25rem);
    }

    .hero .banner-content__inner {
      gap: clamp(0.75rem, 2vw, var(--banner-content-gap, 1.5rem));
    }

    .hero .banner-content__slot {
      width: min(var(--banner-content-width), calc(100% - (2 * var(--hero-content-safe-inset))));
    }

    .hero .banner-content__inner .text-block,
    .hero .banner-content__inner .text-block > * {
      max-width: 100%;
      overflow-wrap: anywhere;
      hyphens: auto;
    }

    .hero .banner-content__inner :is(h1, h2, h3, .h1, .h2, .h3) {
      font-size: clamp(1.75rem, 4.2vw, 3.25rem);
      line-height: 1.15;
    }
  }

  /* Desktop: keep left gutter so text never touches viewport edge */
  @media screen and (min-width: 990px) {
    .hero {
      --hero-content-safe-inset: max(var(--page-margin, 1rem), 2rem);
    }

    .hero .banner-content__slot {
      width: min(var(--banner-content-width), calc(100% - (2 * var(--hero-content-safe-inset))));
    }
  }

  .hero--no-blocks-auto-height {
    .hero__media {
      width: 100%;
      aspect-ratio: auto;
    }

    .hero__media-grid {
      /* When there are no blocks and the height is auto, allow the image to appear. */
      position: relative;
    }
  }

  .hero__media-wrapper {
    overflow: hidden;
    position: relative;
  }

  .hero__media {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
    z-index: var(--layer-base);
  }

  /* Mobile/Desktop media visibility */

  .hero__media-wrapper--mobile {
    display: none;
  }

  .hero__media-wrapper--desktop {
    display: block;
  }

  @media screen and (max-width: 749px) {
    /* Fixed mobile heights need a real height so absolute/flex overlay can fill the section */
    .hero.hero--mobile-height-small,
    .hero.hero--mobile-height-medium,
    .hero.hero--mobile-height-large {
      height: calc(var(--hero-min-height-mobile) - var(--hero-height-offset));
      min-height: calc(var(--hero-min-height-mobile) - var(--hero-height-offset));
    }

    .hero.hero--height-adaptive.hero--mobile-height-small,
    .hero.hero--height-adaptive.hero--mobile-height-medium,
    .hero.hero--height-adaptive.hero--mobile-height-large {
      height: auto;
      min-height: calc(var(--hero-min-height-mobile) - var(--hero-height-offset));
    }

    .hero.hero--mobile-height-small .hero__container,
    .hero.hero--mobile-height-medium .hero__container,
    .hero.hero--mobile-height-large .hero__container {
      min-height: 100%;
      height: 100%;
    }

    .hero.hero--has-banner:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper,
    .hero:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper:has(.banner-content) {
      display: block !important;
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 100%;
    }

    .hero.hero--has-banner:not(.hero--stack-content-mobile):not(.hero--height-adaptive) .hero__content-wrapper > *,
    .hero:not(.hero--stack-content-mobile):not(.hero--height-adaptive)
      .hero__content-wrapper:has(.banner-content)
      > * {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    .hero:not(.hero--has-banner):not(.hero--stack-content-mobile):not(.hero--height-adaptive)
      .hero__content-wrapper:not(:has(.banner-content)) {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 100%;
    }

    /* Large + stack: stretch to fit centered text on top + media below; grow if needed */
    .hero.hero--mobile-height-large.hero--stack-content-mobile {
      height: auto;
    }

    .hero.hero--mobile-height-large.hero--stack-content-mobile .hero__container {
      min-height: inherit;
      height: auto;
      justify-content: space-between;
    }

    .hero__media-wrapper--desktop {
      display: none;
    }

    .hero__media-wrapper--mobile {
      display: block;
    }

    .hero__media-grid {
      grid-template-columns: repeat(var(--hero-media-count-mobile, 1), minmax(0, 1fr));
    }

    .hero:not(.hero--stack-mobile) .hero__media-grid[data-media-count-mobile='2'] {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    /* Mobile stacking */
    .hero--stack-mobile .hero__media-grid {
      grid-template-columns: 1fr;
      grid-template-rows: repeat(var(--hero-media-count-mobile, 1), calc(100% / var(--hero-media-count-mobile, 1)));
    }

    /*
      Stack content above media (Figma mobile): text/CTA on top, media below.
      Default remains overlay — only when mobile_content_layout = stack.
    */
    .hero--stack-content-mobile .hero__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      min-height: unset;
      height: auto;
      gap: var(--hero-mobile-stack-gap, 8px);
    }

    .hero.hero--mobile-height-small.hero--stack-content-mobile .hero__container,
    .hero.hero--mobile-height-medium.hero--stack-content-mobile .hero__container,
    .hero.hero--mobile-height-large.hero--stack-content-mobile .hero__container {
      min-height: inherit;
    }

    .hero--stack-content-mobile .hero__content-wrapper {
      position: relative;
      inset: unset;
      order: 1;
      z-index: var(--layer-flat);
      width: 100%;
      height: auto;
      min-height: 0;
      align-self: stretch;
      padding-block-start: var(--hero-mobile-stack-pad-top, 48px);
      padding-block-end: var(--hero-mobile-stack-pad-bottom, 16px);
      padding-inline: var(--hero-mobile-stack-pad-inline, 24px);
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .hero--stack-content-mobile .hero__media-grid {
      position: relative;
      inset: unset;
      order: 2;
      width: 100%;
      height: auto;
      min-height: 0;
      aspect-ratio: auto;
      align-self: stretch;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .hero--stack-content-mobile .hero__media-wrapper {
      position: relative;
      inset: unset;
      height: auto;
      width: 100%;
    }

    .hero--stack-content-mobile .hero__media {
      position: relative;
      inset: unset;
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
      object-position: center bottom;
    }

    .hero--stack-content-mobile.hero--height-adaptive .hero__media-grid,
    .hero--stack-content-mobile.hero--height-adaptive .hero__content-wrapper,
    .hero--stack-content-mobile.hero--height-adaptive .hero__link {
      grid-row: auto;
    }

    .hero--stack-content-mobile.hero--height-adaptive .hero__media-wrapper,
    .hero--stack-content-mobile.hero--height-adaptive .hero__media {
      position: relative;
      inset: unset;
      height: auto;
    }

    .hero--stack-content-mobile .hero__link {
      order: 3;
      position: absolute;
      inset: 0;
    }

    .hero--stack-content-mobile .banner-content {
      position: relative;
      inset: auto;
      width: 100%;
      pointer-events: auto;
    }

    .hero--stack-content-mobile .banner-content__slot {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      width: min(var(--banner-content-width-mobile), 100%);
      margin-inline: auto;
    }

    .hero--stack-content-mobile.hero--height-adaptive .banner-content__slot {
      margin-inline-start: auto;
      margin-inline-end: auto;
    }

    .hero--stack-content-mobile .banner-content--align-mobile-center .banner-content__inner,
    .hero--stack-content-mobile .banner-content--align-mobile-center .text-block,
    .hero--stack-content-mobile .banner-content--align-mobile-center .text-block > * {
      --text-align: center;
      text-align: center;
      align-items: center;
    }

    .hero--stack-content-mobile .banner-content--align-mobile-center .button-block,
    .hero--stack-content-mobile .banner-content--align-mobile-center .button {
      margin-inline: auto;
    }
  }

  .hero__link {
    position: absolute;
    inset: 0;
    grid-column: 1 / -1;
  }

  .hero__media-grid,
  .hero__content-wrapper {
    pointer-events: none;

    :is(a, button, input, textarea, select, details, summary) {
      pointer-events: auto;
    }
  }

  .hero__content-wrapper--design-mode * {
    pointer-events: auto;
  }

  .hero[data-blur-shadow='true'] {
    --blurred-reflection-filter-saturate: saturate(1.5);
    --blurred-reflection-mask-image: linear-gradient(to bottom, #000 0%, #000 60%, transparent 100%);
    --blurred-reflection-box-shadow: rgb(0 0 0 / 5%) 0 0 1rem;
    --blurred-reflection-filter-blur: blur(20px);
    --blurred-reflection-scale: scale(2, 1.25);
    --blurred-reflection-padding-block-end: 60px;
  }

  .hero[data-blur-shadow='true'] .hero__container::before {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: var(--blurred-reflection-box-shadow);
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: -1;
  }

  .hero__blurred-image {
    position: absolute;
    inset: 0;
    z-index: -1;
    mask-image: var(--blurred-reflection-mask-image);
    filter: var(--blurred-reflection-filter-saturate);
    pointer-events: none;
    transform: translateY(50%);
    overflow: hidden;
  }

  .hero__blurred-image--desktop {
    display: none;

    @media screen and (min-width: 750px) {
      display: block;
    }
  }

  .hero__blurred-image--mobile {
    display: block;

    @media screen and (min-width: 750px) {
      display: none;
    }
  }

  .hero__blurred-image img,
  .hero__blurred-image svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    filter: var(--blurred-reflection-filter-blur);
    opacity: var(--blur-opacity);
    transform: var(--blurred-reflection-scale);
    padding-block-end: var(--blurred-reflection-padding-block-end);

    &:not(:only-child) {
      width: 50%;

      &:last-child {
        right: 0;
        left: auto;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero",
  "tag": "section",
  "class": "hero-wrapper section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "banner-content"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    },
    {
      "type": "spacer"
    },
    {
      "type": "group"
    },
    {
      "type": "_marquee"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.media_1"
    },
    {
      "type": "select",
      "id": "media_type_1",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type_1 == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_1",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type_1 == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.media_2"
    },
    {
      "type": "select",
      "id": "media_type_2",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type_2 == 'image' }}"
    },
    {
      "type": "video",
      "id": "video_2",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type_2 == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_media"
    },
    {
      "type": "checkbox",
      "id": "stack_media_on_mobile",
      "label": "t:settings.stack_media_on_mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "mobile_content_layout",
      "label": "t:settings.mobile_content_layout",
      "options": [
        {
          "value": "overlay",
          "label": "t:options.overlay"
        },
        {
          "value": "stack",
          "label": "t:options.stack_content_above_media"
        }
      ],
      "default": "overlay",
      "info": "t:info.mobile_content_layout"
    },
    {
      "type": "range",
      "id": "mobile_stack_padding_top",
      "label": "t:settings.mobile_stack_padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.mobile_content_layout == 'stack' }}"
    },
    {
      "type": "range",
      "id": "mobile_stack_padding_bottom",
      "label": "t:settings.mobile_stack_padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.mobile_content_layout == 'stack' }}"
    },
    {
      "type": "range",
      "id": "mobile_stack_padding_inline",
      "label": "t:settings.mobile_stack_padding_inline",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.mobile_content_layout == 'stack' }}"
    },
    {
      "type": "range",
      "id": "mobile_stack_gap",
      "label": "t:settings.mobile_stack_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8,
      "visible_if": "{{ section.settings.mobile_content_layout == 'stack' }}"
    },
    {
      "type": "range",
      "id": "mobile_overlay_pad_top",
      "label": "t:settings.mobile_overlay_pad_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
