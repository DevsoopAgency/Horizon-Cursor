

{% liquid
  if section.settings.collection_list != blank
    assign section_collections = section.settings.collection_list
    assign max_items = section.settings.collection_list.count
  elsif section.settings.layout_type == 'editorial'
    assign max_items = section.settings.max_collections
  elsif section.settings.layout_type == 'bento'
    assign max_items = 4
  elsif section.settings.layout_type == 'carousel'
    assign max_items = section.settings.columns | plus: 2
  elsif section.settings.layout_type == 'grid'
    assign max_items = section.settings.columns
  endif
%}

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign card_aspect = section.settings.card_aspect_ratio | default: 'adapt'
  assign card_radius = section.settings.card_corner_radius | default: 0
  assign card_height_custom = section.settings.custom_card_height | default: 437
  assign tablet_height = section.settings.tablet_card_height | default: 380
  assign mobile_layout = section.settings.mobile_layout | default: 'two_columns'

  assign card_ratio = 'unset'
  assign card_height_desktop = 'auto'
  assign card_styles_active = false

  case card_aspect
    when 'figma_portrait'
      assign card_styles_active = true
      assign card_ratio = '9 / 16'
      assign card_height_desktop = '437px'
    when 'square'
      assign card_styles_active = true
      assign card_ratio = '1 / 1'
      assign card_height_desktop = 'auto'
    when 'custom'
      assign card_styles_active = true
      assign card_ratio = 'unset'
      assign card_height_desktop = card_height_custom | append: 'px'
  endcase

  if card_radius > 0
    assign card_styles_active = true
  endif

  assign section_classes = 'section section--' | append: section.settings.section_width
  assign section_classes = section_classes | append: ' section-resource-list spacing-style gap-style collection-list'

  if section.settings.background_color != blank
    assign section_classes = section_classes | append: ' color-custom-' | append: section.id
  endif

  if card_styles_active
    assign section_classes = section_classes | append: ' collection-list--styled-cards'
  endif

  assign section_classes = section_classes | append: ' collection-list--mobile-' | append: mobile_layout
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="{{ section_classes }}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
  data-testid="collection-list"
>
  <div class="section-resource-list__content">
    {%- content_for 'blocks' -%}
  </div>

  {% if section_collections == null %}
    {% for i in (1..max_items) %}
      {% assign section_collections = section_collections | append: ', ' %}
    {% endfor %}

    {% assign section_collections = section_collections | split: ',' %}
  {% endif %}

  {% capture list_items %}
    {% for collection in section_collections limit: max_items %}
      <div class="resource-list__item">
        {% content_for 'block', type: '_collection-card', id: 'static-collection-card', closest.collection: collection %}
      </div>
      {% unless forloop.last %}
        <!--@list/split-->
      {% endunless %}
    {% endfor %}
  {% endcapture %}

  {% liquid
    # Create an array from the list items to be used for different layout types
    assign list_items_array = list_items | strip | split: '<!--@list/split-->'
  %}

  {% render 'resource-list',
    list_items: list_items,
    list_items_array: list_items_array,
    settings: section.settings,
    carousel_ref: 'collectionList',
    slide_count: max_items,
    content_type: 'collections',
    test_id: 'collections-list-grid'
  %}
</div>

{% style %}
  #shopify-section-{{ section.id }} {
    --collection-card-aspect-ratio: {{ card_ratio }};
    --collection-card-height-desktop: {{ card_height_desktop }};
    --collection-card-height-tablet: {{ tablet_height }}px;
    --collection-card-radius: {{ card_radius }}px;
    --collection-card-content-padding: {{ section.settings.card_content_padding | default: 20 }}px;
    --collection-card-content-gap: {{ section.settings.card_content_gap | default: 8 }}px;
    --collection-card-title-size: {{ section.settings.card_title_font_size | default: 28 }}px;
    --collection-card-title-weight: {{ section.settings.card_title_font_weight | default: 700 }};
    --collection-card-subtitle-size: {{ section.settings.card_subtitle_font_size | default: 14 }}px;
    --collection-card-subtitle-color: {{ section.settings.card_subtitle_color | default: 'rgba(255, 255, 255, 0.7)' }};
    --collection-card-cta-size: {{ section.settings.card_cta_font_size | default: 12 }}px;
    --collection-list-tablet-columns: {{ section.settings.tablet_columns | default: 3 }};
    --collection-list-swipe-card-width: {{ section.settings.mobile_swipe_card_width | default: 75 }}%;
  }

  {% if card_styles_active and card_aspect != 'adapt' %}
    #shopify-section-{{ section.id }} .collection-card.collection-card--image-bg {
      --ratio: {{ card_ratio }};
    }
  {% endif %}
{% endstyle %}

{% stylesheet %}
  .collection-list.collection-list--styled-cards .collection-card {
    --border-radius: var(--collection-card-radius);
  }

  .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg .collection-card__inner,
  .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg .collection-card__image,
  .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg .resource-image {
    border-radius: var(--collection-card-radius);
  }

  .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg .overlay {
    --overlay-border-radius: var(--collection-card-radius);
  }

  .collection-list.collection-list--styled-cards .collection-card--image-bg .collection-card__content {
    padding: var(--collection-card-content-padding);
    gap: var(--collection-card-content-gap);
  }

  .collection-list.collection-list--styled-cards .collection-card__content > .text-block:first-child,
  .collection-list.collection-list--styled-cards .collection-card__content > .text-block:first-child p {
    font-size: var(--collection-card-title-size);
    font-weight: var(--collection-card-title-weight);
    line-height: 1.2;
  }

  .collection-list.collection-list--styled-cards .collection-card__content > .text-block:nth-child(2),
  .collection-list.collection-list--styled-cards .collection-card__content > .text-block:nth-child(2) p {
    font-size: var(--collection-card-subtitle-size);
    color: var(--collection-card-subtitle-color);
    line-height: 1.4;
  }

  .collection-list.collection-list--styled-cards .collection-card__content .button-link-arrow {
    font-size: var(--collection-card-cta-size);
  }

  .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg {
    aspect-ratio: var(--collection-card-aspect-ratio, var(--ratio));
  }

  @media screen and (min-width: 991px) {
    .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg {
      height: var(--collection-card-height-desktop);
    }

    .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg[data-aspect="square"],
    .collection-list.collection-list--styled-cards .collection-card--image-bg[data-aspect="square"] {
      height: auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 990px) {
    .collection-list .resource-list--grid {
      grid-template-columns: repeat(var(--collection-list-tablet-columns), 1fr);
    }

    .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg {
      height: var(--collection-card-height-tablet);
    }

    .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg[data-aspect="square"] {
      height: auto;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-list.collection-list--mobile-one_column .resource-list--grid:not(.hidden--mobile) {
      grid-template-columns: 1fr;
    }

    .collection-list.collection-list--mobile-two_columns .resource-list--grid:not(.hidden--mobile) {
      grid-template-columns: repeat(2, 1fr);
    }

    .collection-list.collection-list--styled-cards .collection-card.collection-card--image-bg {
      height: auto;
    }

    .collection-list.collection-list--mobile-swipe_carousel .resource-list--grid:not(.hidden--mobile) {
      display: flex;
      flex-flow: row nowrap;
      align-items: stretch;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      grid-template-columns: none;
      gap: var(--resource-list-column-gap);
      scrollbar-width: none;
    }

    .collection-list.collection-list--mobile-swipe_carousel .resource-list--grid:not(.hidden--mobile)::-webkit-scrollbar {
      display: none;
    }

    .collection-list.collection-list--mobile-swipe_carousel .resource-list--grid:not(.hidden--mobile) .resource-list__item {
      flex: 0 0 var(--collection-list-swipe-card-width);
      width: var(--collection-list-swipe-card-width);
      max-width: var(--collection-list-swipe-card-width);
      scroll-snap-align: start;
      height: auto;
      min-width: 0;
    }

    .collection-list.collection-list--mobile-swipe_carousel .collection-card,
    .collection-list.collection-list--mobile-swipe_carousel .collection-card.collection-card--image-bg {
      height: auto;
      width: 100%;
      flex: none;
    }
  }
{% endstylesheet %}

