{% liquid
  assign ss = section.settings

  if ss.background_color != blank
    render 'contrast-override', background_color: ss.background_color, section_id: section.id
  endif

  assign card_bg = ss.card_background | default: '#FCE4EF'
  assign card_radius = ss.card_corner_radius | default: 16
  assign card_gap = ss.card_gap | default: 40
  assign card_height = ss.card_min_height | default: 333
  assign card_padding = ss.card_padding | default: 32
  assign text_color = ss.text_color | default: '#000000'
  assign quote_icon_color = ss.quote_icon_color | default: '#EF0180'
  assign desktop_columns = ss.desktop_columns | default: '3'
  assign tablet_columns = ss.tablet_columns | default: '2'
  assign tablet_gap = ss.tablet_gap | default: 24
  assign mobile_layout = ss.mobile_layout | default: 'carousel'
  assign mobile_gap = ss.mobile_gap | default: 16
  assign mobile_card_width = ss.mobile_card_width | default: 80
  assign mobile_card_padding = ss.mobile_card_padding | default: 24
  assign horizontal_alignment = ss.horizontal_alignment | default: 'center'
  assign section_gap = ss.gap | default: 24

  case horizontal_alignment
    when 'flex-start'
      assign heading_align = 'left'
    when 'flex-end'
      assign heading_align = 'right'
    else
      assign heading_align = 'center'
  endcase
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --testimonial-card-bg: {{ card_bg }};
    --testimonial-card-radius: {{ card_radius }}px;
    --testimonial-card-gap: {{ card_gap }}px;
    --testimonial-card-height: {{ card_height }}px;
    --testimonial-card-padding: {{ card_padding }}px;
    --testimonial-text-color: {{ text_color }};
    --testimonial-quote-icon-color: {{ quote_icon_color }};
    --testimonial-desktop-columns: {{ desktop_columns }};
    --testimonial-tablet-columns: {{ tablet_columns }};
    --testimonial-tablet-gap: {{ tablet_gap }}px;
    --testimonial-mobile-gap: {{ mobile_gap }}px;
    --testimonial-mobile-card-width: {{ mobile_card_width }}%;
    --testimonial-mobile-card-padding: {{ mobile_card_padding }}px;
    --testimonial-heading-align: {{ heading_align }};
  }
{% endstyle %}

<div
  class="section-background{% if ss.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="
    section
    section--{{ ss.section_width }}
    spacing-style
    {% if ss.background_color != blank %}color-custom-{{ section.id }}{% endif %}
  "
  style="{% render 'spacing-style', settings: ss %}"
>
  <div
    class="testimonials testimonials--{{ section.id }} gap-style"
    style="{% render 'gap-style', value: section_gap %}"
  >
    {% if ss.heading != blank %}
      <div class="testimonials__heading">
        <h2 class="testimonials__heading-text">{{ ss.heading | escape }}</h2>
      </div>
    {% endif %}

    <div
      class="
        testimonials__grid
        testimonials__grid--desktop-{{ desktop_columns }}
        testimonials__grid--tablet-{{ tablet_columns }}
        testimonials__grid--mobile-{{ mobile_layout }}
      "
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .testimonials {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 24px);
    width: 100%;
    min-width: 0;
  }

  .testimonials__heading {
    text-align: var(--testimonial-heading-align, center);
    width: 100%;
  }

  .testimonials__heading-text {
    margin: 0;
    color: var(--testimonial-text-color, #000000);
  }

  .testimonials__grid {
    display: grid;
    width: 100%;
    min-width: 0;
  }

  /* Theme blocks wrap cards in .shopify-block */
  .testimonials__grid > * {
    min-width: 0;
    height: 100%;
  }

  .testimonials__grid .testimonial-card {
    height: 100%;
  }

  /* Mobile < 768px */
  .testimonials__grid--mobile-stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--testimonial-mobile-gap, 16px);
  }

  .testimonials__grid--mobile-carousel {
    display: flex;
    flex-flow: row nowrap;
    align-items: stretch;
    gap: var(--testimonial-mobile-gap, 16px);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--page-margin, 16px));
    padding-inline: var(--page-margin, 16px);
    width: calc(100% + var(--page-margin, 16px) * 2);
  }

  .testimonials__grid--mobile-carousel::-webkit-scrollbar {
    display: none;
  }

  .testimonials__grid--mobile-carousel > * {
    flex: 0 0 var(--testimonial-mobile-card-width, 80%);
    width: var(--testimonial-mobile-card-width, 80%);
    max-width: none;
    height: auto;
    scroll-snap-align: start;
    min-width: 0;
  }

  @media screen and (max-width: 767px) {
    .testimonials__grid--mobile-carousel .testimonial-card {
      height: auto;
      min-height: 0;
      padding: var(--testimonial-mobile-card-padding, 24px);
    }
  }

  /* Tablet 750–1199px */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .testimonials__grid,
    .testimonials__grid--mobile-stacked,
    .testimonials__grid--mobile-carousel {
      display: grid;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
      gap: var(--testimonial-tablet-gap, 24px);
    }

    .testimonials__grid--tablet-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .testimonials__grid--tablet-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .testimonials__grid--mobile-carousel > * {
      flex: unset;
      max-width: none;
      width: auto;
      height: 100%;
    }

    .testimonials__grid--mobile-carousel .testimonial-card {
      height: 100%;
      min-height: var(--testimonial-card-height, 333px);
      padding: var(--testimonial-card-padding, 32px);
    }
  }

  /* Desktop ≥ 1200px */
  @media screen and (min-width: 1200px) {
    .testimonials__grid,
    .testimonials__grid--mobile-stacked,
    .testimonials__grid--mobile-carousel {
      display: grid;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
      gap: var(--testimonial-card-gap, 40px);
    }

    .testimonials__grid--desktop-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .testimonials__grid--desktop-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .testimonials__grid--desktop-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .testimonials__grid--mobile-carousel > * {
      flex: unset;
      max-width: none;
      width: auto;
      height: 100%;
    }

    .testimonials__grid--mobile-carousel .testimonial-card {
      height: 100%;
      min-height: var(--testimonial-card-height, 333px);
      padding: var(--testimonial-card-padding, 32px);
    }
  }
{% endstylesheet %}

